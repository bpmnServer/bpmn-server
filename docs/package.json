{
  "name": "bpmnServer.docs",
  "version": "2.1.12",
  "private": true,
  "description": "The bpmn-server documentation site (mkdocs) and the scripts that generate parts of it",
  "license": "MIT",
  "scripts": {
    "map": "python src/scripts/site-map.py",
    "toc": "node src/scripts/generate-toc docs/examples.md,docs/scripting.md,docs/data.md",
    "build": "mkdocs build",
    "start": "mkdocs serve",
    "deploy": "gh workflow run docs.yml --ref main",
    "run": "nodemon --watch ./src/scripts --exec node src/scripts/includeMd.js example1.md example1.out",
    "generate": "npm run _docs:generate:copy && npm run _docs:generate:api",
    "incl": "cd docs && node ../src/scripts/includeMd.js example1.md example1.out",
    "_docs:generate:api": "cd ../packages/bpmn-server && rimraf ../../docs/docs/api && typedoc --options typedoc.json",
    "_docs:generate:copy": "ts-node src/scripts/copy-readme.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpmnServer/bpmn-server.git",
    "directory": "docs"
  },
  "keywords": [
    "BPMN",
    "BPMN 2.0",
    "Workflow",
    "Node.js",
    "TypeScript"
  ],
  "author": {
    "name": "ralphhanna"
  },
  "devDependencies": {
    "glob": "^11.0.3",
    "markdown-toc": "^1.2.0",
    "nodemon": "^3.0.1",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typedoc": "^0.25.13",
    "typedoc-plugin-markdown": "^3.17.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "gray-matter": "^4.0.3"
  }
}
