node_modules/
# apps made with bpmn-server init while trying it
my-new-app*/

# notes and drafts: kept in bpmn-internal/work
work/

# npm run test:coverage
/coverage/

# the editor's saved versions of models and its deleted runs
**/processes/.history/
**/processes/.runs.del/

# API_TRACE: every API call and its answer, written while the app runs (bpmn-server setup turns it on)
api-trace.jsonl

# machine settings and secrets: only the .example files belong in git. .env.bak is the Settings page's backup of one
# (routes/integration.ts), so it holds the same keys
.env
.env.*
!.env.example
*.env.bak
