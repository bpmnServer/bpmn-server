  <bpmn2:process id="Process_1" isExecutable="false">
    <bpmn2:startEvent id="StartEvent_1">
      <bpmn2:outgoing>Flow_0yqircx</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:serviceTask id="Activity_12p1jw6" name="Read the employee">
      <bpmn2:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="id">${data.employeeId}</camunda:inputParameter>
            <camunda:outputParameter name="fullName">${output.fullName}</camunda:outputParameter>
            <camunda:outputParameter name="jobTitle">${output.jobTitle}</camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>hr/employee.read</camunda:connectorId>
        </camunda:connector>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_0yqircx</bpmn2:incoming>
      <bpmn2:outgoing>Flow_16xbe4u</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:serviceTask id="Activity_0jszojg" name="Add the assignment">
      <bpmn2:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="body.workItem">${data.workItemId}</camunda:inputParameter>
            <camunda:inputParameter name="body.assignee">${({ kind: 'record', entity: 'Employee', id: data.employeeId })}</camunda:inputParameter>
            <camunda:inputParameter name="body.type">Candidate</camunda:inputParameter>
            <camunda:outputParameter name="assignmentId">${output.id}</camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>hr/assignment.assign</camunda:connectorId>
        </camunda:connector>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_16xbe4u</bpmn2:incoming>
      <bpmn2:outgoing>Flow_1q8afym</bpmn2:outgoing>
    </bpmn2:serviceTask>
