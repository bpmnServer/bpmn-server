<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="github-repo-definitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:error id="NotFoundError" name="Not found" errorCode="HTTP_404" />
  <bpmn:process id="GitHubRepo" name="GitHub repository" isExecutable="true">
    <bpmn:startEvent id="Asked">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="owner" label="Owner" type="string" defaultValue="bpmnServer" />
          <camunda:formField id="repo" label="Repository" type="string" defaultValue="bpmn-server" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:outgoing>toGet</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="GetRepo" name="Get the repository">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="owner">${data.owner}</camunda:inputParameter>
            <camunda:inputParameter name="repo">${data.repo}</camunda:inputParameter>
            <camunda:outputParameter name="description">${output.description}</camunda:outputParameter>
            <camunda:outputParameter name="starsCount">${output.stargazers_count}</camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>github/repos/get</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>toGet</bpmn:incoming>
      <bpmn:outgoing>toDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="NoSuchRepo" name="No such repository" attachedToRef="GetRepo">
      <bpmn:outgoing>toNotFound</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="NotFoundError" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Done">
      <bpmn:incoming>Flow_0n1y7b6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="NotFound" name="Not found">
      <bpmn:incoming>toNotFound</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="toGet" sourceRef="Asked" targetRef="GetRepo" />
    <bpmn:sequenceFlow id="toDone" sourceRef="GetRepo" targetRef="test1" />
    <bpmn:sequenceFlow id="toNotFound" sourceRef="NoSuchRepo" targetRef="NotFound" />
    <bpmn:task id="test1">
      <bpmn:incoming>toDone</bpmn:incoming>
      <bpmn:outgoing>Flow_0n1y7b6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_0n1y7b6" sourceRef="test1" targetRef="Done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_GitHubRepo">
    <bpmndi:BPMNPlane id="BPMNPlane_GitHubRepo" bpmnElement="GitHubRepo">
      <bpmndi:BPMNShape id="Asked_di" bpmnElement="Asked">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GetRepo_di" bpmnElement="GetRepo">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NotFound_di" bpmnElement="NotFound">
        <dc:Bounds x="357" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0p38tyt_di" bpmnElement="test1">
        <dc:Bounds x="410" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Done_di" bpmnElement="Done">
        <dc:Bounds x="612" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NoSuchRepo_di" bpmnElement="NoSuchRepo">
        <dc:Bounds x="207" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toGet_di" bpmnElement="toGet">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toDone_di" bpmnElement="toDone">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="410" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toNotFound_di" bpmnElement="toNotFound">
        <di:waypoint x="225" y="128" />
        <di:waypoint x="225" y="210" />
        <di:waypoint x="357" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0n1y7b6_di" bpmnElement="Flow_0n1y7b6">
        <di:waypoint x="510" y="70" />
        <di:waypoint x="612" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
