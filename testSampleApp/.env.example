# PORT # for express application
PORT=3000

#API_KEY is used for remote access
API_KEY=12345

#ADMIN_API_KEY is required for definition/model administration routes
ADMIN_API_KEY=replace-with-a-different-secret

# MongoDB Settings
MONGO_DB_URL=mongodb://0.0.0.0:27017/bpmn
#
DEFINITIONS_PATH="./processes/"
SESSION_SECRET=omni-secret

# Used to identify Servers when using multiple servers, each server needs a unique Id
SERVER_ID=PRIMARY

# --- Mail Setting  USING google email

SITE_NAME=BPMN.SERVER

# CHANGE TO YOUR GOOGLE EMAIL ADDRESS
EMAIL_FROM=myemail@gmail.com	
SMTP_USER=username@gmail.com	
# CHANGE TO YOUR GOOGLE EMAIL PASSWORD  - see this link https://miracleio.me/snippets/use-gmail-with-nodemailer/
SMTP_PASSWORD=<your application password here>	


# -- Security Setting
# if true, would direct users to login page, requires registration
# valid values:	true	flase

REQUIRE_AUTHENTICATION=false
ENFORCE_SECURITY=false
# true: no administration pages or /admin APIs for anyone (a public demo); administer with npm run cli
DISABLE_ADMIN=false
# true: a public demo. Scripts run in a sandbox; timers and service tasks do not run
DEMO_MODE=false
# true (with DEMO_MODE, DISABLE_ADMIN, REQUIRE_AUTHENTICATION and ENFORCE_SECURITY true): visitors try it
# without signing in, as guests with models of their own (in GUESTS_PATH, default ./guests)
GUEST_ACCESS=false
