          "schema": {
            "type": "string"
          },
          "description": "The ID of the file to get"
        }
      ]
    },
    {
      "connector": "replicate.files.download",
      "title": "Download a file",
      "packageVersion": "1.0.0",
      "method": "GET",
      "baseUrl": "https://api.replicate.com/v1",
      "path": "/files/{file_id}/download",
      "authentication": "apiKey",
      "parameters": [
        {
          "name": "file_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "The ID of the file to download"
        },
        {
          "name": "owner",
          "in": "query",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "The username of the user or organization that uploaded the file"
        },
        {
          "name": "expiry",
          "in": "query",
          "required": true,
          "schema": {
            "format": "int64",
            "type": "integer"
          },
          "description": "A Unix timestamp with expiration date of this download URL"
        },
        {
          "name": "signature",
          "in": "query",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "A base64-encoded HMAC-SHA256 checksum of the string '{owner} {id} {expiry}' generated with the Files API signing secret"
        }
      ]
    },
    {
      "connector": "replicate.hardware.list",
      "title": "List available hardware for models",
      "packageVersion": "1.0.0",
      "method": "GET",
      "baseUrl": "https://api.replicate.com/v1",
