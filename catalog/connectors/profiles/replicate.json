{
  "name": "replicate",
  "title": "Replicate",
  "source": "https://api.replicate.com/openapi.json",
  "authentication": "apiKey",
  "operations": [
    {
      "connector": "replicate.account.get",
      "title": "Get the authenticated account",
      "packageVersion": "1.0.0",
      "method": "GET",
      "baseUrl": "https://api.replicate.com/v1",
      "path": "/account",
      "authentication": "apiKey",
      "parameters": []
    },
    {
      "connector": "replicate.collections.list",
      "title": "List collections of models",
      "packageVersion": "1.0.0",
      "method": "GET",
      "baseUrl": "https://api.replicate.com/v1",
      "path": "/collections",
      "authentication": "apiKey",
      "parameters": []
    },
    {
      "connector": "replicate.collections.get",
      "title": "Get a collection of models",
      "packageVersion": "1.0.0",
      "method": "GET",
      "baseUrl": "https://api.replicate.com/v1",
      "path": "/collections/{collection_slug}",
      "authentication": "apiKey",
      "parameters": [
        {
          "name": "collection_slug",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "The slug of the collection, like `super-resolution` or `image-restoration`. See [replicate.com/collections](https://replicate.com/collections).\n"
        }
      ]
    },
    {
      "connector": "replicate.deployments.list",
      "title": "List deployments",
      "packageVersion": "1.0.0",
      "method": "GET",
      "baseUrl": "https://api.replicate.com/v1",
      "path": "/deployments",
      "authentication": "apiKey",
      "parameters": []
    },
    {
      "connector": "replicate.deployments.create",
      "title": "Create a deployment",
      "packageVersion": "1.0.0",
      "method": "POST",
      "baseUrl": "https://api.replicate.com/v1",
      "path": "/deployments",
      "authentication": "apiKey",
      "parameters": [
        {
          "name": "body",
          "in": "body",
          "required": true,
          "schema": {
            "application/json": {
              "schema": {
                "properties": {
                  "hardware": {
                    "description": "The SKU for the hardware used to run the model. Possible values can be retrieved from the `hardware.list` endpoint.",
                    "type": "string"
                  },
                  "max_instances": {
                    "description": "The maximum number of instances for scaling.",
                    "maximum": 20,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "min_instances": {
                    "description": "The minimum number of instances for scaling.",
                    "maximum": 5,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "model": {
                    "description": "The full name of the model that you want to deploy e.g. stability-ai/sdxl.",
                    "type": "string"
                  },
                  "name": {
                    "description": "The name of the deployment.",
                    "type": "string"
                  },
                  "version": {
                    "description": "The 64-character string ID of the model version that you want to deploy.",
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "model",
                  "version",
                  "hardware",
                  "min_instances",
                  "max_instances"
                ],
                "type": "object"
              }
            }
          }
        }
      ]
    },
    {
      "connector": "replicate.deployments.delete",
      "title": "Delete a deployment",
      "packageVersion": "1.0.0",
      "method": "DELETE",
      "baseUrl": "https://api.replicate.com/v1",
      "path": "/deployments/{deployment_owner}/{deployment_name}",
      "authentication": "apiKey",
      "parameters": [
        {
          "name": "deployment_owner",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "The name of the user or organization that owns the deployment.\n"
        },
        {
          "name": "deployment_name",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "The name of the deployment.\n"
        }
      ]
    },
    {
      "connector": "replicate.deployments.get",
