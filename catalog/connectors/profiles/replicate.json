    },
    {
      "connector": "replicate.models.list",
      "title": "List public models",
      "packageVersion": "1.0.0",
      "method": "GET",
      "baseUrl": "https://api.replicate.com/v1",
      "path": "/models",
      "authentication": "apiKey",
      "parameters": [
        {
          "name": "sort_by",
          "in": "query",
          "schema": {
            "default": "latest_version_created_at",
            "enum": [
              "model_created_at",
              "latest_version_created_at"
            ],
            "type": "string"
          },
          "description": "Field to sort models by. Defaults to `latest_version_created_at`.\n"
        },
        {
          "name": "sort_direction",
          "in": "query",
          "schema": {
            "default": "desc",
            "enum": [
              "asc",
              "desc"
            ],
            "type": "string"
          },
          "description": "Sort direction. Defaults to `desc` (descending, newest first).\n"
        }
      ]
    },
    {
      "connector": "replicate.models.create",
      "title": "Create a model",
      "packageVersion": "1.0.0",
      "method": "POST",
      "baseUrl": "https://api.replicate.com/v1",
      "path": "/models",
      "authentication": "apiKey",
      "parameters": [
        {
          "name": "body",
          "in": "body",
          "required": true,
          "schema": {
            "application/json": {
              "schema": {
                "properties": {
                  "cover_image_url": {
                    "description": "A URL for the model's cover image. This should be an image file.",
                    "type": "string"
                  },
                  "description": {
                    "description": "A description of the model.",
                    "example": "Detect hot dogs in images",
                    "type": "string"
                  },
                  "github_url": {
                    "description": "A URL for the model's source code on GitHub.",
                    "example": "https://github.com/alice/hot-dog-detector",
                    "type": "string"
                  },
                  "hardware": {
                    "description": "The SKU for the hardware used to run the model. Possible values can be retrieved from the `hardware.list` endpoint.",
                    "example": "cpu",
                    "type": "string"
                  },
                  "license_url": {
                    "description": "A URL for the model's license.",
                    "type": "string"
                  },
                  "name": {
                    "description": "The name of the model. This must be unique among all models owned by the user or organization.",
                    "example": "hot-dog-detector",
                    "type": "string"
                  },
                  "owner": {
                    "description": "The name of the user or organization that will own the model. This must be the same as the user or organization that is making the API request. In other words, the API token used in the request must belong to this user or organization.",
                    "example": "alice",
                    "type": "string"
                  },
                  "paper_url": {
                    "description": "A URL for the model's paper.",
                    "example": "https://arxiv.org/abs/2504.17639",
                    "type": "string"
                  },
                  "visibility": {
                    "description": "Whether the model should be public or private. A public model can be viewed and run by anyone, whereas a private model can be viewed and run only by the user or organization members that own the model.",
                    "enum": [
                      "public",
                      "private"
                    ],
                    "example": "public",
                    "type": "string"
                  }
                },
                "required": [
                  "owner",
                  "name",
                  "visibility",
                  "hardware"
                ],
                "type": "object"
              }
            }
          }
        }
      ]
    },
