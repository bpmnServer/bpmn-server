    {
      "connector": "replicate.files.create",
      "title": "Create a file",
      "packageVersion": "1.0.0",
      "method": "POST",
      "baseUrl": "https://api.replicate.com/v1",
      "path": "/files",
      "authentication": "apiKey",
      "parameters": [
        {
          "name": "body",
          "in": "body",
          "required": false,
          "schema": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "content": {
                    "description": "The file content",
                    "format": "binary",
                    "type": "string"
                  },
                  "filename": {
                    "description": "The filename",
                    "maxLength": 255,
                    "type": "string"
                  },
                  "metadata": {
                    "default": {},
                    "description": "User-provided metadata associated with the file",
                    "type": "object"
                  },
                  "type": {
                    "default": "application/octet-stream",
                    "description": "The content / MIME type for the file",
                    "type": "string"
                  }
                },
                "required": [
                  "content"
                ],
                "type": "object"
              }
            }
          }
        }
      ]
    },
