                  },
                  "VoiceMethod": {
                    "type": "string",
                    "format": "http-method",
                    "enum": [
                      "GET",
                      "POST"
                    ],
                    "description": "The HTTP method we should use to call `voice_url`. Can be: `GET` or `POST`."
                  },
                  "VoiceFallbackUrl": {
                    "type": "string",
                    "format": "uri",
                    "description": "The URL that we should call when an error occurs while retrieving or executing the TwiML from `voice_url`."
                  },
                  "VoiceFallbackMethod": {
                    "type": "string",
                    "format": "http-method",
