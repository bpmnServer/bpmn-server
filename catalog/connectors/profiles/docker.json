      "connector": "docker.get_v2_orgs_name_settings",
      "title": "Get organization settings",
      "packageVersion": "1.0.0",
      "method": "GET",
      "baseUrl": "https://hub.docker.com/",
      "path": "/v2/orgs/{name}/settings",
