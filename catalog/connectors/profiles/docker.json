    },
    {
      "connector": "docker.put_v2_orgs_name_settings",
      "title": "Update organization settings",
      "packageVersion": "1.0.0",
      "method": "PUT",
      "baseUrl": "https://hub.docker.com/",
      "path": "/v2/orgs/{name}/settings",
      "authentication": "bearer",
      "parameters": [
        {
          "name": "name",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "Name of the organization."
        },
        {
          "name": "body",
          "in": "body",
          "required": true,
          "schema": {
            "application/json": {
              "schema": {
                "properties": {
                  "restricted_images": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/restricted_images"
                      },
                      {
                        "required": [
                          "enabled",
                          "allow_official_images",
                          "allow_verified_publishers"
                        ],
                        "type": "object"
                      }
                    ]
                  }
                },
                "required": [
                  "restricted_images"
                ]
              }
            }
          }
        }
      ]
    },
