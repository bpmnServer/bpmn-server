    {
      "connector": "openfga.GetConfiguration",
      "title": "[Experimental] Get AuthZEN PDP configuration and capabilities",
      "packageVersion": "1.0.0",
      "method": "GET",
      "baseUrl": "",
      "path": "/.well-known/authzen-configuration/{store_id}",
      "authentication": "bearer",
      "parameters": [
        {
          "name": "store_id",
          "in": "path",
          "required": true,
          "description": "The store ID for which to retrieve configuration.\nFollowing the AuthZEN spec's multi-tenant pattern, each store has its own discovery endpoint."
        }
      ]
    },
    {
      "connector": "openfga.ListStores",
      "title": "List all stores",
      "packageVersion": "1.0.0",
      "method": "GET",
      "baseUrl": "",
      "path": "/stores",
      "authentication": "bearer",
      "parameters": [
        {
          "name": "page_size",
          "in": "query",
          "required": false
        },
        {
          "name": "continuation_token",
          "in": "query",
          "required": false
        },
        {
          "name": "name",
          "in": "query",
          "required": false,
          "description": "The name parameter instructs the API to only include results that match that name./nMultiple results may be returned. Only exact matches are returned; substring matches and regexes are not be evaluated."
        }
      ]
    },
