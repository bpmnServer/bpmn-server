#!/bin/sh
# bpmn: the name of ./owf before 3.7, kept until 4.0. It runs ./owf, downloading it the first time.
set -eu
DIR=$(dirname "$(readlink -f "$0")")
if [ ! -f "$DIR/owf" ]; then
    echo "bpmn is now owf: downloading ./owf (use it from now on)" >&2
    curl -fsSL https://raw.githubusercontent.com/bpmnServer/bpmn-server/main/docker/owf -o "$DIR/owf"
fi
exec sh "$DIR/owf" "$@"
