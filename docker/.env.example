# Copy this to .env in the installation folder and replace all CHANGE_ME values.
# The up.sh and up.cmd scripts generate real secrets automatically instead.
PORT=3000
MONGO_DB_URL=memory
REQUIRE_AUTHENTICATION=true
ENFORCE_SECURITY=true
API_SERVICE_USER_NAME=integration
API_SERVICE_USER_GROUPS=SYSTEM
API_KEY=CHANGE_ME
ADMIN_API_KEY=CHANGE_ME_TOO
SESSION_SECRET=CHANGE_ME_SESSION_SECRET
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
