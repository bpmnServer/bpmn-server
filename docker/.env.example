# Copy this to .env in the installation folder and replace all CHANGE_ME values.
# The up.sh and up.cmd scripts generate real secrets automatically instead.
PORT=3000
# MongoDB, in a container of its own (docker-compose.mongo.yml, which setup.sh and up.sh add); memory keeps nothing
MONGO_DB_URL=mongodb://mongo:27017/bpmn
REQUIRE_AUTHENTICATION=true
ENFORCE_SECURITY=true
API_SERVICE_USER_NAME=integration
API_SERVICE_USER_GROUPS=SYSTEM
API_KEY=CHANGE_ME
ADMIN_API_KEY=CHANGE_ME_TOO
SESSION_SECRET=CHANGE_ME_SESSION_SECRET
# encrypts the secrets the server stores (a connector's own key). Keep it: a backup needs the same one
SECRETS_KEY=CHANGE_ME_SECRETS_KEY
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
