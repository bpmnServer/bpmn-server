#!/bin/sh
# owf: the Docker installation's command; the native install has its own owf. Before 3.7 it was named bpmn.
set -eu
DIR=$(dirname "$(readlink -f "$0")")
cd "$DIR"
command -v docker >/dev/null 2>&1 || { echo "Docker not installed" >&2; exit 1; }
if docker info >/dev/null 2>&1; then
    dock() { docker "$@"; }
elif [ "$(id -u)" -ne 0 ] && command -v sudo >/dev/null 2>&1; then
    dock() { sudo docker "$@"; }
else
    echo "No Docker access; run with sudo" >&2; exit 1
fi
setting() { if [ -f .env ]; then sed -n "s/^$1=//p" .env | head -n 1; fi; }
db=$(setting MONGO_DB_URL)
image=$(setting BPMN_IMAGE)
port=$(setting PORT)
port=${port:-3000}
# Keep Docker Compose overlays consistent with setup.sh.
dc() {
    case "$db:$image" in
        mongodb://mongo:*:bpmn-server:local)
            dock compose -f docker-compose.yml -f docker-compose.mongo.yml -f docker-compose.build.yml "$@" ;;
        mongodb://mongo:*)
            dock compose -f docker-compose.yml -f docker-compose.mongo.yml "$@" ;;
        *:bpmn-server:local)
            dock compose -f docker-compose.yml -f docker-compose.build.yml "$@" ;;
        *) dock compose -f docker-compose.yml "$@" ;;
    esac
}
cmd=${1:-help}
[ "$#" -eq 0 ] || shift
case "$cmd" in
    help|-h|--help)
        cat <<'HELP'
BPMN Server Docker management

  owf status              Container state and HTTP endpoint
  owf logs [options]      Follow server logs; --tail=100 for a snapshot
  owf monitor             Live container stats and recent logs
  owf start               Start the configured installation
  owf stop                Stop without deleting volumes
  owf restart             Recreate container to apply .env changes
  owf update              Pull or rebuild image, then recreate
  owf env                 Edit .env and optionally apply
  owf cli [arguments]     Application console in container
  owf password            Display initial admin password from .env
  owf setup               Interactive Docker setup
  owf help                This help

Memory database mode loses user and instance data on recreation.
CLI runs in a separate process and cannot access the live memory database.
HELP
        ;;
    status)
        echo "BPMN Server Docker: $DIR"
        dc ps -a
        if command -v curl >/dev/null 2>&1; then
            code=$(curl --noproxy '*' -s -o /dev/null -w '%{http_code}' --max-time 3 "http://127.0.0.1:$port/login" 2>/dev/null || :)
            echo "URL: http://localhost:$port/login (HTTP ${code:-unavailable})"
        fi ;;
    logs)
        if [ "$#" -eq 0 ]; then dc logs -f server; else dc logs "$@" server; fi ;;
    monitor)
        while :; do
            printf '\033[H\033[2J'
            date
            dc ps -a
            id=$(dc ps -q server || :)
            if [ -n "$id" ]; then dock stats --no-stream "$id" || :; fi
            dc logs --tail=12 server || :
            sleep 3
        done ;;
    start) dc up -d --remove-orphans; echo "Open http://localhost:$port" ;;
    stop) dc stop ;;
    restart)
        echo "Recreating container (memory database will be reset)."
        dc up -d --force-recreate --remove-orphans ;;
    update)
        case "$image" in
            *:local) dc up -d --build --force-recreate --remove-orphans ;;
            *) dc pull server && dc up -d --force-recreate --remove-orphans ;;
        esac ;;
    env)
        [ -f .env ] || { echo "No .env: run ./owf setup" >&2; exit 1; }
        "${EDITOR:-nano}" .env
        printf 'Apply changes now? [y/N] '
        IFS= read -r answer || answer=
        case "$answer" in y|Y|yes|YES) dc up -d --force-recreate --remove-orphans ;; *) echo "Saved; run ./owf restart to apply." ;; esac ;;
    cli)
        if [ "$db" = memory ]; then
            echo "Warning: separate CLI process cannot access the running in-memory database." >&2
        fi
        dc exec server npm run cli -- "$@" ;;
    password)
        value=$(setting ADMIN_PASSWORD)
        [ -n "$value" ] || { echo "No initial ADMIN_PASSWORD in $DIR/.env" >&2; exit 1; }
        printf 'Initial admin password (not a reset), from %s/.env: %s\n' "$DIR" "$value" ;;
    setup) [ -f setup.sh ] || { echo "Missing setup.sh" >&2; exit 1; }; sh setup.sh "$@" ;;
    *) echo "Unknown command: $cmd (use ./owf help)" >&2; exit 2 ;;
esac
