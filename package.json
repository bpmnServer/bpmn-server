{
  "name": "bpmn-web",
  "version": "3.0.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "description": "bpmn-web Demo App",
  "type": "module",
  "author": {
    "name": "bpmnServer RalphHanna"
  },
  "scripts": {
    "build": "tsc --build && npm run build:modeler",
    "build:modeler": "node modeler/build.mjs",
    "watch:modeler": "node modeler/build.mjs --watch",
    "prestart": "npm run build:modeler",
    "start": "node --import tsx src/main.ts",
    "start:prod": "node dist/main.js",
    "cli": "node --import tsx src/scripts/cli.ts",
    "setup": "node --import tsx src/scripts/setup.ts",
    "clean": "tsc --build --clean",
    "test": "npm run test:unit && npm run test:client && npm run test:engine && npm run test:web",
    "test:client": "node --test \"client-tests/*.test.mjs\"",
    "test:engine": "node --test web-engine.test.mjs",
    "pretest:ui": "npm run build:modeler",
    "test:ui": "node --test --test-concurrency=1 \"test/ui/*.test.mjs\"",
    "test:web": "node --test --test-concurrency=1 \"test/web/*.test.mjs\"",
    "test:unit": "node --test apikey-auth.test.mjs web-security.test.mjs account-security.test.mjs dashboard-header.test.mjs error-details.test.mjs bpmn-svg.test.mjs architecture-boundary.test.mjs admin-route-boundary.test.mjs",
    "lint:models": "node modeler/lint-models.mjs"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.3.0",
    "bpmn-auto-layout": "^1.3.0",
    "bpmn-moddle": "^10.0.0",
    "bpmn-server": "^3.2.0",
    "compression": "^1.8.1",
    "connect-busboy": "^1.0.0",
    "connect-flash": "^0.1.1",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "errorhandler": "^1.5.2",
    "express": "^5.2.1",
    "express-flash": "^0.0.2",
    "express-rate-limit": "^8.6.0",
    "express-session": "^1.19.0",
    "gsap": "3.12.2",
    "helmet": "^8.3.0",
    "lodash": "^4.18.1",
    "lusca": "^1.7.0",
    "mailchecker": "^6.0.21",
    "mongoose": "^9.8.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pug": "^3.0.4",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@bpmn-io/element-template-chooser": "^3.0.0",
    "@bpmn-io/properties-panel": "^3.58.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/lodash": "^4.17.24",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/validator": "^13.15.10",
    "bpmn-js": "^18.31.1",
    "bpmn-js-element-templates": "^2.40.2",
    "bpmn-js-properties-panel": "^5.65.3",
    "bpmnlint": "^12.0.0",
    "camunda-bpmn-js-behaviors": "^1.18.0",
    "camunda-bpmn-moddle": "^8.0.2",
    "dmn-js": "^17.12.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.61.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
