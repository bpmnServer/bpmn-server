{
  "name": "bpmnserver4",
  "private": true,
  "workspaces": [
    "packages/bpmn-server",
    "packages/bpmn-client",
    "packages/bpmn-mcp",
    "packages/bpmn-web",
    "apps/testSampleApp",
    "apps/sampleApp"
  ],
  "scripts": {
    "build": "npm run build -w bpmn-server -w bpmn-client -w bpmn-web",
    "test": "npm test -w bpmn-server -w bpmn-client -w test-sample-app",
    "start": "npm start -w test-sample-app",
    "dev": "concurrently -k -n app,modeler -c blue,magenta \"npm run dev -w test-sample-app\" \"npm run watch:modeler -w bpmn-web\"",
    "docs": "cd docs && npm run start",
    "features": "node scripts/features.mjs",
    "test:coverage": "node scripts/coverage.mjs"
  },
  "overrides": {
    "preact": "^10.29.8",
    "serialize-javascript": "^7.1.3"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "concurrently": "^9.2.5",
    "yaml": "^2.9.1"
  }
}
