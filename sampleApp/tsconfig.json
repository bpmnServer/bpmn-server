{
  "compilerOptions": {
    "module": "NodeNext", "moduleResolution": "NodeNext",
    "target": "ES2022", "lib": ["ES2022"],
    "esModuleInterop": true, "skipLibCheck": true, "strict": false,
    "noEmit": true, "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "test"]
}
