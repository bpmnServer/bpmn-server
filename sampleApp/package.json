{
  "name": "sample-app",
  "version": "1.0.0",
  "private": true,
  "description": "A workflow application on bpmn-server and bpmn-web: what npx bpmn-server init creates",
  "type": "module",
  "scripts": {
    "start": "tsx index.ts",
    "dev": "tsx watch index.ts",
    "setup": "tsx index.ts --setup",
    "cli": "tsx index.ts --cli",
    "mcp": "bpmn-mcp",
    "verify": "bpmn-server verify processes",
    "services": "node ../packages/bpmn-web/dist/scanServices.js delegates/appDelegate.ts services.json"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "bpmn-mcp": "*",
    "bpmn-server": "*",
    "bpmn-web": "*",
    "dayjs": "^1.11.21",
    "pug": "^3.0.4",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
