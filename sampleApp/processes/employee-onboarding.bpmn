<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="@bpmnkit/core" exporterVersion="0.0.23" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:collaboration id="Collaboration_1n5vpn1">
    <bpmn:participant id="Participant_0rmkc0o" processRef="employee-onboarding" />
  </bpmn:collaboration>
  <bpmn:process id="employee-onboarding" name="Employee Onboarding" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="1.0.0" />
    </bpmn:extensionElements>
    <bpmn:serviceTask id="enrol-payroll" name="Enrol in payroll">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="payroll-enrol" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_provision_enrol-payroll</bpmn:incoming>
      <bpmn:outgoing>Flow_enrol-payroll_provisioned</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_contract-signed_create-hr-record" sourceRef="contract-signed" targetRef="create-hr-record" />
    <bpmn:sequenceFlow id="Flow_create-hr-record_provision" sourceRef="create-hr-record" targetRef="provision" />
    <bpmn:sequenceFlow id="Flow_provision_provision-accounts" sourceRef="provision" targetRef="provision-accounts" />
    <bpmn:sequenceFlow id="Flow_provision_order-equipment" sourceRef="provision" targetRef="order-equipment" />
    <bpmn:sequenceFlow id="Flow_provision_enrol-payroll" sourceRef="provision" targetRef="enrol-payroll" />
    <bpmn:sequenceFlow id="Flow_provision-accounts_provisioned" sourceRef="provision-accounts" targetRef="provisioned">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"> data.title</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_order-equipment_provisioned" sourceRef="order-equipment" targetRef="provisioned" />
    <bpmn:sequenceFlow id="Flow_enrol-payroll_provisioned" sourceRef="enrol-payroll" targetRef="provisioned" />
    <bpmn:sequenceFlow id="Flow_provisioned_send-welcome" sourceRef="provisioned" targetRef="send-welcome" />
    <bpmn:sequenceFlow id="Flow_send-welcome_role-extras" sourceRef="send-welcome" targetRef="role-extras" />
    <bpmn:sequenceFlow id="Flow_role-extras_grant-dev-tools" name="engineering" sourceRef="role-extras" targetRef="grant-dev-tools">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">data.department == "engineering"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_role-extras_enrol-leadership" name="manager" sourceRef="role-extras" targetRef="enrol-leadership">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">data.isManager</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_role-extras_send-welcome-pack" name="standard" sourceRef="role-extras" targetRef="send-welcome-pack" />
    <bpmn:sequenceFlow id="Flow_grant-dev-tools_dev-ready" sourceRef="grant-dev-tools" targetRef="dev-ready" />
    <bpmn:sequenceFlow id="Flow_enrol-leadership_manager-ready" sourceRef="enrol-leadership" targetRef="manager-ready" />
    <bpmn:sequenceFlow id="Flow_send-welcome-pack_onboarded" sourceRef="send-welcome-pack" targetRef="onboarded" />
    <bpmn:serviceTask id="enrol-leadership" name="Enrol in leadership programme">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="training-enrol" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_role-extras_enrol-leadership</bpmn:incoming>
      <bpmn:outgoing>Flow_enrol-leadership_manager-ready</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="contract-signed" name="Contract signed">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="department" label="Department" type="string" defaultValue="Engineering" />
          <camunda:formField id="isManager" label="Is a Manager" type="boolean" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_contract-signed_create-hr-record</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="create-hr-record" name="Create HR record">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="hris-employee-create" />
        <zeebe:ioMapping>
          <zeebe:output source="=employeeId" target="employeeId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_contract-signed_create-hr-record</bpmn:incoming>
      <bpmn:outgoing>Flow_create-hr-record_provision</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="provision">
      <bpmn:incoming>Flow_create-hr-record_provision</bpmn:incoming>
      <bpmn:outgoing>Flow_provision_provision-accounts</bpmn:outgoing>
      <bpmn:outgoing>Flow_provision_order-equipment</bpmn:outgoing>
      <bpmn:outgoing>Flow_provision_enrol-payroll</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="provision-accounts" name="Provision accounts">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="identity-provision" />
        <zeebe:ioMapping>
          <zeebe:output source="=email" target="workEmail" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_provision_provision-accounts</bpmn:incoming>
      <bpmn:outgoing>Flow_provision-accounts_provisioned</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="order-equipment" name="Order equipment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="equipment-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_provision_order-equipment</bpmn:incoming>
      <bpmn:outgoing>Flow_order-equipment_provisioned</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="provisioned">
      <bpmn:incoming>Flow_provision-accounts_provisioned</bpmn:incoming>
      <bpmn:incoming>Flow_order-equipment_provisioned</bpmn:incoming>
      <bpmn:incoming>Flow_enrol-payroll_provisioned</bpmn:incoming>
      <bpmn:outgoing>Flow_provisioned_send-welcome</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="send-welcome" name="Send welcome email">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="email-send" />
        <zeebe:taskHeaders>
          <zeebe:header key="template" value="welcome" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_provisioned_send-welcome</bpmn:incoming>
      <bpmn:outgoing>Flow_send-welcome_role-extras</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:inclusiveGateway id="role-extras" name="Role-specific steps" default="Flow_role-extras_send-welcome-pack">
      <bpmn:incoming>Flow_send-welcome_role-extras</bpmn:incoming>
      <bpmn:outgoing>Flow_role-extras_grant-dev-tools</bpmn:outgoing>
      <bpmn:outgoing>Flow_role-extras_enrol-leadership</bpmn:outgoing>
      <bpmn:outgoing>Flow_role-extras_send-welcome-pack</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:serviceTask id="grant-dev-tools" name="Grant developer tooling">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="devtools-grant" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_role-extras_grant-dev-tools</bpmn:incoming>
      <bpmn:outgoing>Flow_grant-dev-tools_dev-ready</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="dev-ready" name="Developer set up">
      <bpmn:incoming>Flow_grant-dev-tools_dev-ready</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="send-welcome-pack" name="Send welcome pack">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="welcome-pack-send" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_role-extras_send-welcome-pack</bpmn:incoming>
      <bpmn:outgoing>Flow_send-welcome-pack_onboarded</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="onboarded" name="Onboarded">
      <bpmn:incoming>Flow_send-welcome-pack_onboarded</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="manager-ready" name="Manager enrolled">
      <bpmn:incoming>Flow_enrol-leadership_manager-ready</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="employee-onboarding_di">
    <bpmndi:BPMNPlane id="employee-onboarding_di_plane" bpmnElement="Collaboration_1n5vpn1">
      <bpmndi:BPMNShape id="Participant_0rmkc0o_di" bpmnElement="Participant_0rmkc0o" isHorizontal="true">
        <dc:Bounds x="1" y="0" width="1450" height="428" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="enrol-payroll_di" bpmnElement="enrol-payroll">
        <dc:Bounds x="541" y="20" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="enrol-leadership_di" bpmnElement="enrol-leadership">
        <dc:Bounds x="1191" y="20" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="contract-signed_di" bpmnElement="contract-signed">
        <dc:Bounds x="55" y="190" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="20" y="230" width="105" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="create-hr-record_di" bpmnElement="create-hr-record">
        <dc:Bounds x="191" y="168" width="100" height="80" />
