      <bpmndi:BPMNShape id="provisioned_di" bpmnElement="provisioned">
        <dc:Bounds x="741" y="183" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="send-welcome_di" bpmnElement="send-welcome">
        <dc:Bounds x="891" y="168" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="role-extras_di" bpmnElement="role-extras">
        <dc:Bounds x="1041" y="183" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1074" y="223" width="133" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="grant-dev-tools_di" bpmnElement="grant-dev-tools">
        <dc:Bounds x="1191" y="328" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dev-ready_di" bpmnElement="dev-ready">
        <dc:Bounds x="1391" y="350" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1353" y="390" width="112" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="send-welcome-pack_di" bpmnElement="send-welcome-pack">
        <dc:Bounds x="1191" y="168" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="onboarded_di" bpmnElement="onboarded">
        <dc:Bounds x="1391" y="190" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1377" y="230" width="63" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="manager-ready_di" bpmnElement="manager-ready">
        <dc:Bounds x="1391" y="42" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1353" y="82" width="112" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_contract-signed_create-hr-record_di" bpmnElement="Flow_contract-signed_create-hr-record">
        <di:waypoint x="91" y="208" />
        <di:waypoint x="191" y="208" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_create-hr-record_provision_di" bpmnElement="Flow_create-hr-record_provision">
        <di:waypoint x="291" y="208" />
        <di:waypoint x="391" y="208" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_provision_provision-accounts_di" bpmnElement="Flow_provision_provision-accounts">
        <di:waypoint x="441" y="208" />
        <di:waypoint x="541" y="208" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_provision_order-equipment_di" bpmnElement="Flow_provision_order-equipment">
        <di:waypoint x="416" y="233" />
        <di:waypoint x="416" y="368" />
        <di:waypoint x="541" y="368" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_provision_enrol-payroll_di" bpmnElement="Flow_provision_enrol-payroll">
        <di:waypoint x="416" y="183" />
        <di:waypoint x="416" y="60" />
        <di:waypoint x="541" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_provision-accounts_provisioned_di" bpmnElement="Flow_provision-accounts_provisioned">
        <di:waypoint x="641" y="208" />
        <di:waypoint x="741" y="208" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_order-equipment_provisioned_di" bpmnElement="Flow_order-equipment_provisioned">
        <di:waypoint x="591" y="328" />
        <di:waypoint x="591" y="288" />
        <di:waypoint x="766" y="288" />
        <di:waypoint x="766" y="233" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_enrol-payroll_provisioned_di" bpmnElement="Flow_enrol-payroll_provisioned">
        <di:waypoint x="591" y="100" />
        <di:waypoint x="591" y="140" />
        <di:waypoint x="766" y="140" />
        <di:waypoint x="766" y="183" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_provisioned_send-welcome_di" bpmnElement="Flow_provisioned_send-welcome">
        <di:waypoint x="791" y="208" />
        <di:waypoint x="891" y="208" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_send-welcome_role-extras_di" bpmnElement="Flow_send-welcome_role-extras">
        <di:waypoint x="991" y="208" />
        <di:waypoint x="1041" y="208" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_role-extras_grant-dev-tools_di" bpmnElement="Flow_role-extras_grant-dev-tools">
        <di:waypoint x="1066" y="233" />
        <di:waypoint x="1066" y="368" />
        <di:waypoint x="1191" y="368" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1061" y="313" width="77" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_role-extras_enrol-leadership_di" bpmnElement="Flow_role-extras_enrol-leadership">
        <di:waypoint x="1066" y="183" />
        <di:waypoint x="1066" y="60" />
        <di:waypoint x="1191" y="60" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1075" y="115" width="49" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_role-extras_send-welcome-pack_di" bpmnElement="Flow_role-extras_send-welcome-pack">
        <di:waypoint x="1091" y="208" />
        <di:waypoint x="1191" y="208" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1113" y="184" width="56" height="14" />
        </bpmndi:BPMNLabel>
