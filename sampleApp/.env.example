# Machine settings and secrets: copy to .env (not committed). npx bpmn-server init writes .env with new keys.
PORT=3000
# a mongodb://... URL, or memory: a MongoDB in the process (npm install mongodb-memory-server), emptied when it stops
MONGO_DB_URL=mongodb://localhost:27017/sample-app
# both, api (the REST APIs only) or ui (the web pages only)
SERVE=both

# REST API keys (x-api-key): API_KEY runs processes, ADMIN_API_KEY also changes models
API_KEY=change-me
ADMIN_API_KEY=change-me-too
# /api2/tasks: an application acting for users it authenticates itself. Unset: those routes answer 404. A secret of its own
#API_ACTING_USER_KEY=
# who /api2 calls run as
API_SERVICE_USER_NAME=integration
API_SERVICE_USER_GROUPS=SYSTEM

SESSION_SECRET=change-me-as-well
# false: no sign-in and no security rules, for development only
REQUIRE_AUTHENTICATION=true
ENFORCE_SECURITY=true
# true: no administration pages or /admin APIs for anyone (a public demo); administer with npm run cli
DISABLE_ADMIN=false
# true: a public demo. Scripts run in a sandbox; timers and service tasks do not run
DEMO_MODE=false
# true (with DEMO_MODE, DISABLE_ADMIN, REQUIRE_AUTHENTICATION and ENFORCE_SECURITY true): visitors try it
# without signing in, as guests with models of their own (in GUESTS_PATH, default ./guests)
GUEST_ACCESS=false

# notifications: EMAIL_ENABLE=true sends them through gmail
EMAIL_ENABLE=false
#SMTP_USER=
#SMTP_PASSWORD=
#EMAIL_FROM=

# --- Operations (all optional)
# NODE_ENV=production: no SESSION_SECRET, no API_KEY or REQUIRE_AUTHENTICATION=false stop the server at start
#ALLOW_INSECURE_NO_AUTH=false
# model import/save APIs: warn (save, log issues), enforce (refuse a model with errors: 422), off
#VERIFY_MODELS_ON_IMPORT=warn
# true: no model design in the web pages (models arrive only through the admin APIs)
#DISABLE_DESIGN=false
# true: no self-registration (/signup); administrators add the accounts
#DISABLE_SIGNUP=false
# false: model saves keep no versions in processes/.history, and the editor has no History tab
#MODEL_HISTORY=true
# the database, when MONGO_DB_URL names none
#MONGO_DB_NAME=
# instance locks: wait between tries, tries before giving up, age after which a lock is taken over
#LOCK_RETRY_DELAY_MS=
#LOCK_MAX_TRIES=
#LOCK_STALE_AFTER_MS=
# on SIGTERM, how long running executions get to finish (default 10000)
#ENGINE_SHUTDOWN_TIMEOUT_MS=10000
