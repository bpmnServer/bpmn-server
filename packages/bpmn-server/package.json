{
  "name": "bpmn-server",
  "version": "3.5.2",
  "description": "BPMN 2.0 Server including Modeling, Execution and Persistence, an open source for Node.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpmnServer/bpmn-server.git",
    "directory": "packages/bpmn-server"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "template": "node scripts/template.mjs",
    "prepack": "npm run build && npm run template",
    "postpack": "node -e \"require('fs').rmSync('templates/app',{recursive:true,force:true})\"",
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "clean": "rimraf dist",
    "test:boundary": "node --test test/api-boundary.test.mjs",
    "pretest": "tsc --build",
    "bench": "node test/perf/bench.mjs",
    "pretest:load": "tsc --build",
    "test:load": "node --test --test-concurrency=1 \"test/load/*.test.mjs\"",
    "test:sqlite": "node --env-file=test/sqlite.env --test --test-concurrency=1 \"test/*.test.mjs\""
  },
  "main": "dist/index.js",
  "bin": {
    "bpmn-server": "dist/cli.js"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bpmn-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": "./*"
  },
  "files": [
    "dist",
    "src",
    "templates",
    "!src/scripts",
    "README.md",
    "CHANGELOG.md",
    "UPSTREAM.md"
  ],
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@lukeed/uuid": "^2.0.1",
    "bpmn-moddle": "^10.1.0",
    "cron-parser": "^5.10.0",
    "dayjs": "^1.11.23",
    "eventemitter3": "^5.0.4",
    "feelin": "^7.0.1",
    "iso8601-duration": "^2.1.4",
    "mongodb": "^7.6.0",
    "quickjs-emscripten-core": "^0.32.0",
    "xml2js": "^0.6.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/xml2js": "^0.4.14",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
