{
  "name": "bpmn-client",
  "version": "3.1.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "start": "node --import tsx src/cli.ts",
    "cli": "node --import tsx src/cli.ts",
    "setup": "node --import tsx src/setup.ts",
    "test": "npm run build && npm run test:unit && npm run test:contract",
    "test:unit": "node --test \"test/unit/*.test.mjs\"",
    "test:contract": "node --test --test-concurrency=1 \"test/contract/*.test.mjs\"",
    "test:live": "node --import tsx ./node_modules/mocha/bin/mocha.js --config=test/.mocharc.json"
  },
  "description": "Client API for BPMN-Server webservices",
  "keywords": [
    "BPMN",
    "BPMN 2.0",
    "Workflow",
    "Node.js",
    "TypeScript"
  ],
  "author": {
    "name": "ralphhanna"
  },
  "repository": {
    "type": "git",
    "url": "git+https:github.com/ralphhanna/bpmn-client.git"
  },
  "bin": {
    "bpmn-client-setup": "./dist/setup.js",
    "bpmn-client-cli": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "axios": "^1.19.0",
    "dotenv": "^17.4.2",
    "form-data": "^4.0.6"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "chai": "^6.2.2",
    "mocha": "^11.8.0",
    "mocha-cakes-2": "^3.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "diff": "^9.0.0",
    "serialize-javascript": "^7.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
