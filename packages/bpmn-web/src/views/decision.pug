doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    if cspHost
      //- allow rendering inside the ITSM host iframe
      meta(http-equiv="Content-Security-Policy" content=`frame-ancestors 'self' ${cspHost}`)
    title= `${name} - Decision editor`
    meta(name="csrf-token" content=_csrf)
    script(src="/javascripts/csrf.js")
    link(rel="stylesheet" href=asset("/modeler/decision.css"))
  body
    #decision-page(data-name=name data-exists=exists ? 'true' : 'false')
      header.modeler-header
        a.brand(href="/" title="Home")
          img(src="https://demo.omniworkflow.com/web//images/omniworkflow_icon.png" alt="Home")
        h1= name
        span.decision-file= `${name}.dmn.xml`
        span#js-save-status.modeler-status(role="status")
        nav#js-views.decision-views(aria-label="Decisions")
        nav.modeler-actions
          button#js-save.primary(type="button" title="Ctrl+S") Save
      .decision-body
        #js-decision.decision-canvas
        //- the dock, as the model editor's: here the Test tab
        section#js-dock.dock(data-tab="test")
          #js-dock-resizer.dock-resizer(title="Drag to resize")
          .dock-bar(role="tablist")
            button#js-tab-test.dock-tab(type="button" role="tab" aria-selected="true" aria-controls="js-test") Test
            .dock-actions
              button#js-dock-toggle(type="button" aria-expanded="true" title="Hide or show" aria-label="Hide or show the tests")
          .dock-body
            #js-test.dock-test(role="tabpanel" aria-label="Test")
    script#model-source(type="application/json")!= modelJson
    script(src=asset("/modeler/decision.js"))
