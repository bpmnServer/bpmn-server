extends ../layout

block content
	h3 Processes to Export
		table
			each proc in procs
				tr 
					a(vertical-align="top")
					td 
						a(href=`/model/download/${proc.name}.bpmn`) #{proc.name}.bpmn
					td 
						a(href=`/model/download/${proc.name}.svg`) #{proc.name}.svg
					td
						each file in tests[proc.name] || []
							a(href=`/model/download/${file}`) #{file}
							br
	p
		a.btn.btn-primary(href='/model/download-all') Download all (.zip)
