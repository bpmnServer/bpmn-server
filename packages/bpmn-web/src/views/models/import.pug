extends ../layout

block content
	h3 Import
	p.text-muted A model (.bpmn) is imported at once. A package (.zip, from Export), or a decision (.dmn, .dmn.xml), is shown first: you choose what to take, and what already here is replaced.
	if problem
		p.text-danger= problem
	div(id="processes")
		form(name="ExecuteForm", action="/model/import", method="post", enctype="multipart/form-data")
			input(type="hidden", name="_csrf", value=_csrf)
			table
				tr
					td
						input(type="file", name="fileUploaded", accept=".bpmn,.dmn,.xml,.zip")
					td
						input(type="submit", value="Import")
	script.
		// lusca checks the CSRF token before the multipart body is read, so the upload sends it as a header
		document.forms.ExecuteForm.addEventListener("submit", async function (event) {
			event.preventDefault();
			const form = event.target;
			const response = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { "X-CSRF-Token": form._csrf.value } });
			if (response.redirected) window.location = response.url;
			else document.open(), document.write(await response.text()), document.close();
		});
