extends layoutDocs
block content
	//- the docs' own pages; the bar above is the same on every page
	p.docs-links(style="margin-left:250px")
		a(href='/docs/api-summary.md') API
		| &nbsp;&middot;&nbsp;
		a(href='/docs/examples.md') Examples
		| &nbsp;&middot;&nbsp;
		a(href='/docs') ReadMe
	table(style="width:100%")
		tr
			if (sidebar)
				td
					div(style="height: 100%;width:220px; position:fixed;z-index:1;top:80px;left:10px;background-color:#eaeaea;overflow-x: hidden;")
						zero-md 
							template
								xmp!=sidebar
			td
				div(style="position:absolute;left:250px")
					zero-md 
						template
							xmp!=md
		