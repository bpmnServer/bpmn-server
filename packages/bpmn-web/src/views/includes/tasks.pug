include labelFilter.pug
include listColumns.pug
div.tasks-content
	h3 Pending Tasks
	//- this list's filter (routes/labelFilter.ts): by the named values of the tasks' cases
	if taskFilter
		+labelFilter(taskFilter)
	if taskView
		+listColumnsPicker(taskView)
	if !waiting.length
		if taskFilter && taskFilter.active
			p.empty-state No pending tasks match this filter.
		else
			p.empty-state There are no pending tasks for this user.
	//- the columns shown, in the person's order (routes/listView.ts); who may work on a task is for administrators
	- var shownColumns = (taskView ? taskView.layout : [{ key: '@task', title: 'Task' }, { key: '@case', title: 'Case' }, { key: '@process', title: 'Process' }, { key: '@waiting', title: 'Waiting' }]).filter(h => (user && user.isAdmin()) || !/^@candidate/.test(h.key))
	table
		tr
			each h in shownColumns
				+listHeading(h)
			th
		each item in waiting
			- var ref1 = "/invokeItem?id="+item.id+"&processName="+item.processName+"&elementId="+item.elementId;
			- var ref2 = "/assign?id="+item.id+"&processName="+item.processName+"&elementId="+item.elementId;
			tr
				each h in shownColumns
					+taskCell(h.key, item)
				td
					//- assignment is optional: whoever may see a task (assignee, candidate, unassigned) may execute it
					a(href=`${ref1}`) Execute
					<br />
					a(href=`${ref2}`) Assign
