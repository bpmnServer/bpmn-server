//- A start event's form: its fields (typed as the model says), then Start. My work lists one per start event; the
//- start page (/execute/<model>) the ones of a model. start: { processName, startNodeId, name, fields }.
mixin startForm(start)
  form.dash-start-form(method='post', action='/dashboard/start')
    input(type='hidden', name='_csrf', value=_csrf)
    input(type='hidden', name='processName', value=start.processName)
    input(type='hidden', name='startNodeId', value=start.startNodeId)
    each field in start.fields
      label(for=`${start.startNodeId}-${field.id}`)= field.label || field.id
      if field.type === 'enum' && field.values && field.values.length
        select(id=`${start.startNodeId}-${field.id}`, name=`field.${field.id}`)
          each v in field.values
            option(value=v.id, selected=(v.id === field.defaultValue))= v.name || v.id
      else if field.type === 'boolean'
        select(id=`${start.startNodeId}-${field.id}`, name=`field.${field.id}`)
          option(value='true') Yes
          option(value='false', selected=(field.defaultValue !== 'true')) No
      else
        input(id=`${start.startNodeId}-${field.id}`, name=`field.${field.id}`, type=(field.type === 'date' ? 'date' : field.type === 'long' ? 'number' : 'text'), value=field.defaultValue || '')
    button.btn.btn-primary.btn-sm(type='submit') Start
