form(name='searchTasks',action="/setUser",method="get")

	if process.env.REQUIRE_AUTHENTICATION === 'false'
		- var selectedUser = request.session.forUser || request.user || user;
		- var forUserName = selectedUser ? selectedUser.userName : '';
		- var forUserGroups = selectedUser && selectedUser.userGroups ? selectedUser.userGroups.join(',') : '';
		tr
			td  Show Data for User:
			td
				input(type="text",name="forUserName",id="forUserName",value=forUserName)
			td  User Groups:
			td 
				input(type="text",name="forUserGroups",id="forUserGroups",value=forUserGroups)
			td  
				input(type='submit',value='Apply')


