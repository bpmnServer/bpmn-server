include labelFilter.pug
include listColumns.pug
h3 Instances
//- this list's filter (routes/labelFilter.ts): the other sections are not filtered
if labelFilter
	+labelFilter(labelFilter)
//- the columns the person shows, in their order, and what it is sorted by (routes/listView.ts)
if instanceView
	+listColumnsPicker(instanceView)
if !instances.length
	if labelFilter && labelFilter.active
		p.empty-state No instances match this filter.
	else
		p.empty-state No instances to show yet. Run a process from Models to create one.
if user && user.isAdmin()
	table
		tr
			form(action='/resetData', method='post')
				input(type='hidden', name='_csrf', value=_csrf)
				button(type='submit') Delete All Instances Data
table
	tr
		//- the columns shown, in the person's order (routes/listView.ts)
		if instanceView
			+listHeadings(instanceView)
		else
			th Process
			th Case
			th Started
			th Ended
		th
		if user && user.isAdmin()
			th
	each instance in instances
		- var ref = "/instanceDetails?id="+instance.id;
		tr
			if instanceView
				each h in instanceView.layout
					+instanceCell(h.key, instance)
			else
				+instanceCell('@process', instance)
				+instanceCell('@case', instance)
				+instanceCell('@started', instance)
				+instanceCell('@ended', instance)
			td
				a(href=`${ref}`) Examine
			if user && user.isAdmin()
				td
					form(action='/deleteInstance', method='post')
						input(type='hidden', name='_csrf', value=_csrf)
						input(type='hidden', name='id', value=instance.id)
						button(type='submit') Delete
//- a page at a time, newest first (API v3's paging): the next page's bookmark
if typeof nextInstances !== 'undefined' && nextInstances
	p.instances-more
		//- newest first: older ones; sorted otherwise, the next page (keeping the filters and views)
		a(href=typeof nextInstancesHref !== 'undefined' && nextInstancesHref ? nextInstancesHref : `/?after=${encodeURIComponent(nextInstances)}#instances`)= String(nextInstances).startsWith('o:') ? 'Next page' : 'Older instances'
