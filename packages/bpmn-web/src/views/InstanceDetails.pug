extends layout

block content
  link(rel="stylesheet", href="/stylesheets/instance-details.css")
  link(rel="stylesheet", href="/modeler/report.css")
  - var docs = JSON.parse(definition || '{}');
  - var info = (logs || []).filter(l => l.type === 'info');
  include includes/dates.pug
  - var lastAt = lastItem && (lastItem.endedAt || lastItem.startedAt);

  script(type="text/javascript").
    var jsonData = !{definition};
    var decorations = !{decorations};
    var startDate = new Date("!{instance.startedAt}");
    function toggleDetails(panelId, buttonId) {
      const panel = document.getElementById(panelId);
      const button = document.getElementById(buttonId);
      panel.hidden = !panel.hidden;
      button.setAttribute('aria-expanded', String(!panel.hidden));
      button.querySelector('.fa').className = panel.hidden ? 'fa fa-chevron-down' : 'fa fa-chevron-up';
    }
    function showDocs() { toggleDetails('docs', 'showDoc'); }
    function showLogs() { toggleDetails('logs', 'showHide'); }
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('#logs table tr td').forEach(function (td) {
        if (td.textContent.startsWith('debug:')) td.classList.add('log-debug');
        if (td.textContent.startsWith('log:Action:')) td.classList.add('log-action');
      });
      setUpFilters();
    });
    // Filters: a type, an element; the items and the Rationale by their rows' element, the logs by the element ids
    // a line names (its action, 'Node(name|id)', a flow's id, ...)
    function setUpFilters() {
      var typeSelect = document.getElementById('filter-type');
      var elementSelect = document.getElementById('filter-element');
      if (!typeSelect || !elementSelect) return;
      var elements = JSON.parse(document.getElementById('filterElements').textContent || '[]');
      var typeOf = {};
      elements.forEach(function (e) { typeOf[e.id] = e.type; });
      var escape = function (s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); };
      var mentions = function (text, ids) {
        return ids.some(function (id) { return new RegExp('(^|[^\\w-])' + escape(id) + '($|[^\\w-])').test(text); });
      };
      function apply() {
        var type = typeSelect.value, element = elementSelect.value;
        // the element list: those of the type
        Array.prototype.forEach.call(elementSelect.options, function (o) { o.hidden = !!(o.value && type && o.dataset.type !== type); });
        if (element && type && typeOf[element] !== type) { elementSelect.value = ''; element = ''; }
        var ids = element ? [element] : type ? elements.filter(function (e) { return e.type === type; }).map(function (e) { return e.id; }) : null;
        var shown = 0, all = 0;
        document.querySelectorAll('#dataTable tbody tr[data-element], .rationale-table tbody tr[data-element]').forEach(function (tr) {
          var show = !ids || ids.indexOf(tr.dataset.element) >= 0;
          tr.hidden = !show;
          if (tr.closest('#dataTable')) { all++; if (show) shown++; }
        });
        document.querySelectorAll('#logs tr.log-row').forEach(function (tr) {
          tr.hidden = !!ids && !mentions(tr.textContent, ids);
        });
        document.getElementById('filter-count').textContent = ids ? shown + ' of ' + all + ' items' : '';
      }
      typeSelect.addEventListener('change', apply);
      elementSelect.addEventListener('change', apply);
      document.getElementById('filter-clear').addEventListener('click', function () {
        typeSelect.value = ''; elementSelect.value = ''; apply();
      });
      // at first: the user tasks, when the instance has any
      if (elements.some(function (e) { return e.type === 'bpmn:UserTask'; })) {
        typeSelect.value = 'bpmn:UserTask';
        apply();
      }
    }

  main#instances.instance-page
    header.instance-page-header
      div
        a.instance-back(href="/#instances")
          i.fa.fa-arrow-left(aria-hidden="true")
          | Back to instances
        h1 #{title}
        p.instance-subtitle #{instance.name}
      span.instance-id(title=instance.id) ID: #{instance.id}

    .instance-summary-grid
      section.instance-card(aria-labelledby="instance-info-heading")
        h2#instance-info-heading Instance information
        dl.instance-facts
          div
            dt Model
            dd #{instance.name}
          div
            dt Status
            - const failedItem = (items || []).find(i => i.status === 'error');
            if failedItem
              dd: span.status-badge.status-error(title=failedItem.statusDetails && failedItem.statusDetails.error) failed at #{failedItem.name || failedItem.elementId}
            else
              dd: span.status-badge(class=lastItem && lastItem.status === 'wait' ? 'status-wait' : 'status-end') #{lastItem ? lastItem.status : 'Unknown'}
          div
            dt Started
            dd #{prettyDate(instance.startedAt) || '—'}
          div
            dt Ended
            dd #{prettyDate(instance.endedAt) || '—'}
          div
            dt Last activity
            dd #{prettyDate(lastAt) || '—'}
          div
            dt Last element
            dd #{lastItem ? lastItem.elementId : '—'}
      section.instance-card(aria-labelledby="instance-data-heading")
        h2#instance-data-heading Instance data
        if vars && vars.length
          dl.instance-facts.instance-data
            each v in vars
              div
                dt #{v.key}
                dd #{v.value}
        else
          p.instance-empty No instance data.

    section.instance-card.instance-diagram-card(aria-labelledby="diagram-heading")
      .instance-card-heading
        h2#diagram-heading Process diagram
        .instance-toolbar
          button#showTokens.btn.btn-default(type="button", onclick="$('.decor-token').toggle()")
            i.fa.fa-map-marker(aria-hidden="true")
            | Show tokens
          button#startAnimation.btn.btn-default(type="button", onclick="startAnimation()")
            i.fa.fa-play(aria-hidden="true")
            | Show animation
        span#animationStatus.instance-animation-status(role="status", aria-live="polite")
      .instance-diagram
        if svg
          div!= svg
        else
          p.instance-empty Diagram unavailable for this instance.
      script(type="application/json" id="jsonInfo")!= JSON.stringify(info)
      script(type="application/json" id="animationItems")!= JSON.stringify((items || []).map(item => ({ id: item.elementId, seq: item.seq, type: item.type, status: item.status }))).replace(/</g, '\\u003c')

    //- Filters for the items, the Rationale and the logs: a type of element, an element (of that type)
    - var kindOf = t => String(t || '').replace(/^bpmn:/, '').replace(/([a-z])([A-Z])/g, '$1 $2').toLowerCase();
    - var filterTypes = [...new Set((items || []).map(i => i.type).filter(Boolean))].sort();
    - var filterElements = []; (items || []).forEach(i => { if (i.elementId && !filterElements.some(e => e.id === i.elementId)) filterElements.push({ id: i.elementId, name: i.name, type: i.type }); });
    section.instance-card.instance-filters(aria-label="Filters")
      label(for="filter-type") Type
      select#filter-type.form-control
        option(value="") All types
        each t in filterTypes
          option(value=t) #{kindOf(t)}
      label(for="filter-element") Element
      select#filter-element.form-control
        option(value="") All elements
        each el in filterElements
          option(value=el.id data-type=el.type) #{el.name ? `${el.name} (${el.id})` : el.id}
      button#filter-clear.btn.btn-default(type="button") Clear
      span#filter-count.instance-hint(role="status")
      script(type="application/json" id="filterElements")!= JSON.stringify(filterElements.map(e => ({ id: e.id, type: e.type }))).replace(/</g, '\\u003c')

    section.instance-card(aria-labelledby="items-heading")
      .instance-card-heading
        div
          h2#items-heading Instance items
          p.instance-hint Times are measured from the start of execution.
      .instance-table-scroll
        table#dataTable.instance-table
          thead
            tr
              th(scope="col") Seq #
              th(scope="col") Element ID
              th(scope="col") Name
              th(scope="col") Started
              th(scope="col") Ended
              th(scope="col") Status
              th(scope="col") Type
              th(scope="col") User
              th(scope="col") Action
              th(scope="col") Assignee
              th(scope="col") Candidate users
              th(scope="col") Candidate groups
              th(scope="col") Due date
              th(scope="col") Follow-up date
              th(scope="col") Priority
          tbody
            - let seq = 0;
            each item in (items || [])
              - var ref = `?id=${encodeURIComponent(item.id)}&processName=${encodeURIComponent(instance.name)}&elementId=${encodeURIComponent(item.elementId)}`;
              - var label = (item.status === 'wait' && item.type === 'bpmn:UserTask') ? 'Execute' : '';
              - var label2 = (item.status === 'wait' && item.type === 'bpmn:UserTask') ? 'Assign' : '';
              - if (user && user.isAdmin() && item.status === 'wait' && item.type.includes('Event')) label = 'Force';
              - var key = item.itemKey ? `[${item.itemKey}]` : '';
              - seq++;
              tr(data-element=item.elementId)
                //- the engine's seq (from 1), as the Rationale, the diagram and the log give it
                td #{item.seq != null ? item.seq : seq}
                td.instance-nowrap #{item.elementId}
                td #{item.name} #{key}
                td.instance-nowrap #{prettyDate(item.startedAt)}
                td.instance-nowrap #{prettyDate(item.endedAt)}
                td
                  span.status-badge(class=item.status === 'wait' ? 'status-wait' : item.status === 'error' ? 'status-error' : 'status-end') #{item.status}
                  if item.status === 'error' && item.statusDetails && item.statusDetails.error
                    div.item-error #{item.statusDetails.error}
                td.instance-nowrap #{item.type}
                td #{item.userName}
                td.instance-actions
                  if item.status === 'error' && user && user.isAdmin()
                    form.retry-form(action="/retryItem" method="post")
                      input(type="hidden" name="_csrf" value=_csrf)
                      input(type="hidden" name="itemId" value=item.id)
                      button.btn.btn-primary.btn-xs(type="submit" title="Run the task's work again") Retry
                  if label
                    a.btn.btn-primary.btn-xs(href=`/invokeItem${ref}`) #{label}
                    if label2
                      a.btn.btn-default.btn-xs(href=`/assign${ref}`) #{label2}
                td #{item.assignee}
                td #{item.candidateUsers}
                td #{item.candidateGroups}
                td.instance-nowrap #{prettyDate(item.dueDate)}
                td.instance-nowrap #{prettyDate(item.followUpDate)}
                td #{item.priority}
            if !items || !items.length
              tr
                td(colspan="15") No items to show.

    //- The run as it happened: the log, in its order, a row for each event of an item (started, waits, ended, taken,
    //- ...) and for each decision (why a flow was taken, what a gateway chose, why a join waited). Its columns are
    //- the items': the element's id, name and type.
    -
      var ACTION = /^\{"seq":(\d+),"type":'([^']*)',"id":'([^']*)',"action":'([^']*)'\}$/;
      var WORDS = { Started: 'started', Waiting: 'waits', Arrived: 'a branch arrived', Ended: 'ended', Taken: 'taken', Aborted: 'aborted', Cancelled: 'cancelled' };
      var whyOf = d => d.action ? (String(d.message || '').split('\nwhy:\n')[1] || '').replace(/^ {4}/gm, '') : String(d.message || '');
      var bySeq = {}, byId = {};
      (items || []).forEach(i => { bySeq[i.seq] = i; if (!byId[i.elementId]) byId[i.elementId] = i; });
      // a decision's element, from its label ("flow 'yes' (ToApprove)", "gateway gateway_1") when it has no item
      var fromLabel = label => {
        var id = (/\(([^()]+)\)$/.exec(label || '') || /(\S+)$/.exec(label || '') || [])[1];
        var item = byId[id];
        return { id, name: item ? item.name : (/'([^']*)'/.exec(label || '') || [])[1], type: item ? item.type : /^flow /.test(label || '') ? 'bpmn:SequenceFlow' : '' };
      };
      var t0 = instance.startedAt ? new Date(instance.startedAt).getTime() : null;
      var elapsed = at => { if (!at || t0 == null) return ''; var s = Math.max(0, (new Date(at).getTime() - t0) / 1000); return s < 60 ? s.toFixed(1) + 's' : Math.floor(s / 60) + 'm ' + Math.round(s % 60) + 's'; };
      var events = [];
      (logs || []).forEach(l => {
        var m = l && l.type === 'info' && ACTION.exec(String(l.message || ''));
        if (m) {
          var item = bySeq[Number(m[1])] || byId[m[3]];
          var word = WORDS[m[4]] || m[4].toLowerCase();
          if (m[4] === 'Ended' && item && /UserTask/.test(item.type)) word = 'completed' + (item.userName ? ' by ' + item.userName : '');
          // waiting as it starts: one row, "started · waits"
          var startedRow = m[4] === 'Waiting' && [...events].reverse().find(e => e.seq === Number(m[1]) && e.raw !== 'decision');
          if (startedRow && startedRow.raw === 'Started') { startedRow.word += ' · waits'; startedRow.raw = 'Waiting'; return; }
          events.push({ id: m[3], name: item ? item.name : '', type: m[2], seq: Number(m[1]), date: l.date, word, raw: m[4], decisions: [] });
        }
        else if (l && l.type === 'decision')
          events.push(Object.assign(fromLabel(l.element), { seq: l.seq, date: l.date, word: '', raw: 'decision', decisions: [l] }));
      });
    section.instance-card.instance-collapsible(aria-labelledby="rationale-heading")
      .instance-card-heading
        div
          h2#rationale-heading Rationale
          p.instance-hint What happened, in order, from the start to the end, and why: conditions with the values they read, gateways, joins, timers.
        button#showRationale.btn.btn-default(type="button", onclick="toggleDetails('rationale', 'showRationale')", aria-expanded="false", aria-controls="rationale", aria-label="Toggle the Rationale")
          i.fa.fa-chevron-down(aria-hidden="true")
      #rationale.instance-table-scroll(hidden)
        table.instance-table.rationale-table
          thead
            tr
              th(scope="col") Seq #
              th(scope="col") At
              th(scope="col") Element ID
              th(scope="col") Name
              th(scope="col") Type
              th(scope="col") What happened
              th(scope="col") Why
          tbody
            each e in events
              tr(class=e.decisions.length ? 'rationale-chose' : undefined data-element=e.id)
                td #{e.seq != null ? e.seq : ''}
                td.instance-nowrap #{elapsed(e.date)}
                td.instance-nowrap #{e.id || ''}
                td #{e.name || ''}
                td.instance-nowrap #{e.type || ''}
                td.instance-nowrap
                  if e.word
                    if e.raw === 'Waiting'
                      span.status-badge.status-wait #{e.word}
                    else if e.raw === 'Aborted' || e.raw === 'Cancelled'
                      span.status-badge.status-error #{e.word}
                    else
                      | #{e.word}
                  each d in e.decisions
                    if d.action && d.action !== e.word
                      div.rationale-decision(class=/^not taken|takes no flow/.test(d.action) ? 'rationale-not' : undefined) #{d.action}
                td.rationale-why
                  each d in e.decisions
                    div #{whyOf(d)}
            if !events.length
              tr
                td(colspan="7") Nothing to show: the server keeps an instance's log when its configuration says so (SAVE_LOGS).

    section.instance-card.instance-collapsible(aria-labelledby="docs-heading")
      .instance-card-heading
        h2#docs-heading Model report
        button#showDoc.btn.btn-default(type="button", onclick="showDocs()", aria-expanded="false", aria-controls="docs", aria-label="Toggle the model report")
          i.fa.fa-chevron-down(aria-hidden="true")
      #docs.instance-report(hidden)
        script(type="application/json" data-report-source="model-report")!= modelJson
        #model-report
      script(src="/modeler/report.js" defer)

    section.instance-card.instance-collapsible(aria-labelledby="logs-heading")
      .instance-card-heading
        h2#logs-heading Instance logs
        button#showHide.btn.btn-default(type="button", onclick="showLogs()", aria-expanded="false", aria-controls="logs", aria-label="Toggle instance logs")
          i.fa.fa-chevron-down(aria-hidden="true")
      #logs.instance-table-scroll(hidden)
        table.instance-table
          tbody
            each log in (logs || [])
              tr.log-row
                td.instance-nowrap #{prettyDate(log.date)}
                td(class=log.type === 'decision' ? 'log-decision' : undefined) #{log.message}
            if !logs || !logs.length
              tr
                td(colspan="2") No logs to show.
