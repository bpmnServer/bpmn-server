extends layout

block intro
	p.dash-intro The server, its users, and the operations the console offers: locks, hung items, backup, restart.

block dash
	.dash-grid
		section.dash-card.wide#instances
			h2 Instances
			.dash-stats
				.dash-stat
					b= counts.running
					span running
				.dash-stat
					b= counts.waiting
					span waiting on a task
				.dash-stat
					b= counts.end
					span ended
				.dash-stat
					b= counts.terminated
					span cancelled
				.dash-stat
					b= counts.error
					span failed

		section.dash-card#server
			h2 Server
			dl
				dt bpmn-web
				dd= serverInfo.bpmnWeb
				dt bpmn-server
				dd= serverInfo.bpmnServer
				dt Node.js
				dd= serverInfo.node
				dt Running for
				dd= serverInfo.uptime
				dt Database
				dd: code= serverInfo.database
				dt Models folder
				dd: code= serverInfo.models
				if serverInfo.serverId
					dt Server id
					dd= serverInfo.serverId
			h2(style='margin-top:18px') Backup
			p.dash-muted The models folder and the database (instances, models, users, test scenarios) as one JSON file.
			a.btn.btn-default.btn-sm#backup(href='/dashboard/admin/backup') Download a backup
			h2(style='margin-top:18px') Restart
			if supervisor
				p.dash-muted The server stops and #{supervisor} starts it again. Running work is given time to finish.
				form.inline(method='post', action='/dashboard/admin/restart', onsubmit="return confirm('Restart the server?')")
					input(type='hidden', name='_csrf', value=_csrf)
					button.btn.btn-warning.btn-sm(type='submit') Restart the server
			else
				p.dash-muted Nothing restarts this server when it stops: run it under Docker, pm2 or systemd (or set RESTART_ON_EXIT=true for a supervisor of your own) to restart it from here.

		section.dash-card#operations
			h2 Locks
				span.count= locks.length
			if locks.length
				table
					tr
						th Instance
						th Server
						th Held
						th
					each lock in locks
						tr
							td: code= lock.id
							td= lock.server
							td= lock.fromNow
							td
								form.inline(method='post', action='/dashboard/admin/locks/release')
									input(type='hidden', name='_csrf', value=_csrf)
									input(type='hidden', name='id', value=lock.id)
									button.btn.btn-default.btn-xs(type='submit') Release
				form.inline(method='post', action='/dashboard/admin/locks/release', onsubmit="return confirm('Release every lock?')")
					input(type='hidden', name='_csrf', value=_csrf)
					button.btn.btn-default.btn-sm(type='submit', style='margin-top:8px') Release all
			else
				p.dash-empty No instance is locked.
			h2(style='margin-top:18px') Hung items
				span.count= hung.length
			p.dash-muted Items that started and never finished (a server stopped while running them).
			if hung.length
				table
					tr
						th Process
						th Item
						th Since
						th
					each item in hung
						tr
							td: a(href=`/instanceDetails?id=${item.instanceId}`)= item.processName
							td= item.name || item.elementId
							td= item.fromNow
							td
								form.inline(method='post', action='/dashboard/admin/recover')
									input(type='hidden', name='_csrf', value=_csrf)
									input(type='hidden', name='itemId', value=item.id)
									input(type='hidden', name='instanceId', value=item.instanceId)
									button.btn.btn-default.btn-xs(type='submit') Run again
			else
				p.dash-empty Nothing is hung.

		section.dash-card#users
			h2 Users
				if users
					span.count= users.length
			if !users
				p.dash-muted The application signs people in and manages its users: add and change them there.
			else
				table
					tr
						th User
						th Email
						th Groups
						th
					each u in users
						tr
							td= u.userName
							td= u.email
							td= (u.userGroups || []).join(', ')
							td: a(href=`/account/edit/${u._id}`) Edit
				h2(style='margin-top:18px') Add a user
				form.dash-form#add-user(method='post', action='/dashboard/admin/users')
					input(type='hidden', name='_csrf', value=_csrf)
					label(for='new-userName') User name
					input#new-userName(name='userName', required)
					label(for='new-email') Email
					input#new-email(name='email', type='email', required)
					label(for='new-password') Password
					input#new-password(name='password', type='password', required, minlength='4')
					label(for='new-groups') Groups
					input#new-groups(name='userGroups', placeholder='e.g. Employee, Manager, DESIGNER, ADMIN')
					button.btn.btn-primary.btn-sm(type='submit') Add user

		//- roles: none passed (an older route) shows nothing
		if typeof roles !== 'undefined' && roles
			section.dash-card#roles
				h2 Roles
					span.count= roles.list.length
				p.dash-muted A role is the user group of the same name. The models' lanes and the assignment policies name them; the models' checks warn about one that isn't here (roles.json in the models folder).
				if roles.error
					p.text-danger roles.json can not be read: #{roles.error}
				else
					if roles.list.length
						table
							tr
								th Role
								th Used by
								th Users
								th
							each role in roles.list
								tr
									td= role.name
									td
										if role.uses.length
											= role.uses.join('; ')
										else
											span.dash-muted not used yet
									td= role.members === null ? '' : role.members
									td
										form.inline(method='post', action='/dashboard/admin/roles/delete', onsubmit=`return confirm(${JSON.stringify(role.uses.length ? `Remove the role '${role.name}'? It is used by: ${role.uses.join('; ')}` : `Remove the role '${role.name}'?`)})`)
											input(type='hidden', name='_csrf', value=_csrf)
											input(type='hidden', name='name', value=role.name)
											button.btn.btn-default.btn-xs(type='submit') Remove
					else
						p.dash-muted= roles.file ? 'roles.json lists no roles.' : 'No roles.json yet: add the first role, and it is made.'
					if roles.unlisted.length
						h2(style='margin-top:18px') Used, not listed
						table
							each role in roles.unlisted
								tr
									td= role.name
									td.dash-muted= role.uses.join('; ')
									td
										form.inline(method='post', action='/dashboard/admin/roles')
											input(type='hidden', name='_csrf', value=_csrf)
											input(type='hidden', name='name', value=role.name)
											button.btn.btn-default.btn-xs(type='submit') Add
					h2(style='margin-top:18px') Add a role
					form.dash-form#add-role(method='post', action='/dashboard/admin/roles')
						input(type='hidden', name='_csrf', value=_csrf)
						label(for='new-role') Name
						input#new-role(name='name', required, maxlength='64', placeholder='e.g. Manager')
						button.btn.btn-primary.btn-sm(type='submit') Add role

		//- connectors: none passed (an older route) shows as none
		- const connectorList = typeof connectors === 'undefined' || !connectors ? [] : connectors
		section.dash-card#connectors
			h2 Connectors
				span.count= connectorList.length
			p.dash-muted REST APIs, each described by an OpenAPI document, that service tasks call by name. You add them here with their keys; models never hold a key.
			if connectorList.length
				table
					tr
						th Connector
						th Status
						th Key
					each c in connectorList
						tr
							td: a(href=`/dashboard/admin/connectors/${encodeURIComponent(c.id)}`)= c.name
							td
								if c.enabled
									span.dash-badge.is-ok enabled
								else
									span.dash-badge.is-warning disabled
							td= c.auth && c.auth.last4 ? `${c.auth.type} …${c.auth.last4}` : 'none'
			else
				p.dash-empty No connectors yet.
			if !canEncrypt
				p.dash-muted Set CONNECTORS_KEY in .env (a long random value) to give connectors their keys: they are stored encrypted with it.
			a.btn.btn-default.btn-sm#manage-connectors(href='/dashboard/admin/connectors') Manage connectors

		section.dash-card#console
			h2 Console commands
			p.dash-muted
				| The console does what these pages do and more, from a terminal:
				code npm run cli
				|  (in Docker:
				code docker compose exec bpmn-web npm run cli
				| ).
			table
				each c in commands
					tr
						td: code= c[0]
						td= c[1]
