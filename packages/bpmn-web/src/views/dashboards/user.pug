extends layout

include ../includes/startForm.pug
include ../includes/labelFilter.pug

//- the Case column: a case's label, unless it only repeats its model's name (no label, no case id)
mixin taskRow(item)
	tr
		td
			a(href=`/invokeItem?id=${item.id}&processName=${item.processName}&elementId=${item.elementId}`)= item.name || item.elementId
			//- its own label, when it has one (engine/Labels.ts)
			if item.ownLabel
				.task-label= item.ownLabel
		td= item.caseLabel && item.caseLabel !== item.processName ? item.caseLabel : ''
		td= item.processName
		td= item.fromNow
		td= item.dueDate ? new Date(item.dueDate).toLocaleDateString() : ''

block intro
	p.dash-intro Tasks waiting for you, the ones you completed, and the processes you can start.

block dash
	if labelFilter
		+labelFilter(labelFilter)
	.dash-grid
		section.dash-card#my-tasks
			h2 Assigned to me
				span.count= mine.length
			if mine.length
				table
					tr
						th Task
						th Case
						th Process
						th Waiting
						th Due
					each item in mine
						+taskRow(item)
			else
				p.dash-empty No tasks are assigned to you.

		section.dash-card#available-tasks
			h2 Available to me
				span.count= available.length
			p.dash-muted Not assigned yet: for you, for one of your groups, or for anyone.
			if available.length
				table
					tr
						th Task
						th Case
						th Process
						th Waiting
						th Due
					each item in available
						+taskRow(item)
			else
				p.dash-empty Nothing is waiting for you or your groups.

		section.dash-card#completed-tasks
			h2 Recently completed
				span.count= completed.length
			if completed.length
				table
					tr
						th Task
						th Case
						th Process
						th Completed
					each item in completed
						tr
							td
								= item.name || item.elementId
								if item.ownLabel
									.task-label= item.ownLabel
							td= item.caseLabel && item.caseLabel !== item.processName ? item.caseLabel : ''
							td
								a(href=`/instanceDetails?id=${item.instanceId}`)= item.processName
							td= item.fromNow
			else
				p.dash-empty You have not completed a task yet.

		section.dash-card#start-events
			h2 Start a process
				span.count= starts.length
			if starts.length
				each start in starts
					details.dash-start
						summary
							b= start.processName
							if start.name !== start.processName
								|  · #{start.name}
						+startForm(start)
			else
				p.dash-empty No process can be started by hand.
