extends layout

//- The Integration page (routes/integration.ts): one section per integration point, what is in place and its settings.
//- An administrator changes every setting; a designer the design-side ones. Changes go to .env, applied on restart.

mixin names(list)
  if list && list.length
    each name, i in list
      code= name
      if i < list.length - 1
        | ,&nbsp;
  else
    span.dash-muted none

mixin application(info)
  dl
    dt Delegate
    dd
      if info.delegate
        code= info.delegate
      else
        span.dash-muted none
    dt Functions (appServices)
    dd
      if info.servicesError
        span.dash-muted Made only while a process runs (#{info.servicesError})
      else
        - const functions = info.services.filter(s => s.kind === 'function').map(s => s.name)
        details.integration-list
          summary #{functions.length} function#{functions.length === 1 ? '' : 's'} scripts and expressions call
          +names(functions)
    dt Its hooks
    dd
      details.integration-list
        summary #{info.methods.length} method#{info.methods.length === 1 ? '' : 's'} of its own
        +names(info.methods)
    dt Who signs in
    dd= info.hostUsers ? 'the application (its own user manager)' : "BPMN Server's own users"
  p.dash-muted The delegate is code: the application changes it. #[a(href='https://bpmnserver.github.io/bpmn-server/delegates/' target='docs') About the delegate]

mixin connectors(info)
  if info.list.length
    table
      tr
        th Connector
        th Status
        th Key
        th Used by
      each c in info.list
        tr
          td
            if isAdmin
              a(href=`/dashboard/admin/connectors/${encodeURIComponent(c.id)}`)= c.name
            else
              = c.name
            |
            code= c.id
          td
            if c.enabled
              span.dash-badge.is-ok enabled
            else
              span.dash-badge.is-warning disabled
          td= c.auth && c.auth.last4 ? `${c.auth.type} …${c.auth.last4}` : 'none'
          td: +names(c.models)
  else
    p.dash-empty No connectors yet.
  if !info.canEncrypt
    p.dash-muted Connector keys need CONNECTORS_KEY (below): they are stored encrypted with it.
  if isAdmin
    a.btn.btn-default.btn-sm(href='/dashboard/admin/connectors') Manage connectors

mixin policies(info)
  dl
    dt Roles
    dd
      if info.roles.error
        span.dash-badge.is-warning= info.roles.error
      else
        +names(info.roles.list.map(r => r.name))
        if info.roles.unlisted.length
          .dash-muted Used but not in roles.json: #{info.roles.unlisted.map(r => r.name).join(', ')}
    dt Assignment policies
    dd: +names(info.assignment)
    dt Security policies
    dd
      +names(info.security)
      if info.security.length
        |  (#{info.securityOn ? 'on' : 'off'})
    dt Notification policies
    dd: +names(info.notification)
  p
    if isDesigner
      a.btn.btn-default.btn-sm(href='/dashboard/design#policies') Edit the policies
      | &nbsp;
    if isAdmin
      a.btn.btn-default.btn-sm(href='/dashboard/admin#roles') Manage the roles

mixin notifications(info)
  dl
    dt Delivered by
    dd= info.notify ? "the application's notify" : 'email (the delegate has no notify of its own)'
    dt Kept
    dd
      | #{info.total}
      if info.total
        | (#{Object.entries(info.byStatus).map(([s, n]) => `${n} ${s === 'recorded' ? 'kept, not delivered' : s}`).join(', ')})
  a.btn.btn-default.btn-sm(href='/dashboard/notifications') See the notifications

mixin api(info)
  dl
    dt API v3
    dd: code /api/v3
    dt Task API (acting for a user)
    dd
      code /api2/tasks
      |  #{info.taskApi ? 'on' : 'off: it needs a task API key'}
  if info.hostSettings
    p.dash-muted The application gives these settings itself (hostSettings): they are not changed here.

mixin setting(s)
  tr(data-setting=s.name)
    td
      b= s.label
      .dash-muted
        code= s.name
        if s.editor === 'designer'
          |  · designers too
      if s.description
        .dash-muted= s.description
    td
      if s.secret
        = s.set ? 'set' : 'not set'
      else if s.value !== ''
        code= s.value
      else
        span.dash-muted= s.default !== undefined ? `default (${s.default})` : 'not set'
      if s.source !== 'default'
        .dash-muted= s.source
      if s.pending
        span.dash-badge.is-warning(title='.env holds a change the server will read when it restarts') restart to apply
    td
      if !s.editable
        span.dash-muted= s.source === 'the environment' ? 'set outside .env: change it there' : s.source === 'the application' ? "the application's" : 'administrators'
      else if s.secret
        input.form-control(type='password', name=s.name, autocomplete='new-password', placeholder=s.set ? 'a new value replaces it' : 'not set')
        if s.generate
          label.checkbox-inline
            input(type='checkbox', name='generate:' + s.name)
            |  generate a new one
        if s.set
          label.checkbox-inline
            input(type='checkbox', name='clear:' + s.name)
            |  remove
      else if s.choices
        - const current = s.fileValue === undefined ? '' : s.fileValue
        select.form-control(name=s.name)
          option(value='', selected=current === '') default#{s.default !== undefined ? ` (${s.default})` : ''}
          each c in s.choices
            option(value=c, selected=current === String(c))= c
      else
        input.form-control(type='text', name=s.name, value=s.fileValue === undefined ? '' : s.fileValue, placeholder=s.default !== undefined ? `default: ${s.default}` : (s.examples[0] || ''))

mixin settingsTable(list)
  table.integration-settings
    tr
      th Setting
      th Now
      th Change
    each s in list
      +setting(s)

block intro
  if point
    p: a(href='/dashboard/settings') ← Settings
    p.dash-intro= point.about
  else
    p.dash-intro How the workflows meet the application. Each area says what is in place; open one to set it up.
    p.dash-muted #{isAdmin ? 'You change every setting' : 'You change the settings marked "designers too"; an administrator the others'}. They are saved to #[code= envFile] and apply when the server restarts.
  if separateEngine
    p.dash-intro The engine runs separately (ENGINE_AT): copy a change to its .env too.

block dash
  link(rel="stylesheet", href=asset("/stylesheets/integration.css"))
  if point
    //- one point: what is in place, its main settings, the rest under More settings
    .dash-grid
      section.dash-card.wide(id=point.id)
        case point.id
          when 'application'
            +application(point.info)
          when 'connectors'
            +connectors(point.info)
          when 'policies'
            +policies(point.info)
          when 'notifications'
            +notifications(point.info)
          when 'api'
            +api(point.info)
        if point.settings.length
          - const main = point.settings.filter(s => s.main), more = point.settings.filter(s => !s.main)
          form(method='post', action='/dashboard/settings/' + point.id)
            input(type='hidden', name='_csrf', value=_csrf)
            if main.length
              h3 Settings
              +settingsTable(main)
            if more.length
              details.integration-more(open=!main.length || more.some(s => s.pending))
                summary More settings (#{more.length})
                +settingsTable(more)
            if point.settings.some(s => s.editable)
              p
                button.btn.btn-primary.btn-sm(type='submit') Save
                span.dash-muted  Applies when the server restarts.
    nav.integration-points
      each p, i in points
        if p.id !== point.id
          a(href='/dashboard/settings/' + p.id)= p.title
          if i < points.length - 1
            | &nbsp;·&nbsp;
  else
    //- the overview: each point in a few words
    .integration-overview
      each p in points
        a.integration-card(href='/dashboard/settings/' + p.id, id=p.id)
          h2= p.title
          each line in p.summary.lines
            p= line
          if p.summary.attention
            p.integration-attention= p.summary.attention
          if p.pending
            span.dash-badge.is-warning(title='.env holds a change the server will read when it restarts') restart to apply
          span.integration-open Set up →
    //- the add-ons: each on or off (app-config.json), what it is, the models using it
    section.dash-card.wide#add-ons
      h2 Add-ons
      p.dash-muted What is built on the engine, each turned on when it's needed. Saved to #[code= appConfigFile]; a change applies when the server restarts.
      if addOns.length && addOns[0].problem
        p.integration-attention= addOns[0].problem
      form(method='post', action='/dashboard/settings/add-ons')
        input(type='hidden', name='_csrf', value=_csrf)
        table.integration-settings
          each a in addOns
            tr(data-addon=a.name)
              td
                label
                  input(type='checkbox', name='addon:' + a.name, checked=a.saved, disabled=!isAdmin)
                  |  #[strong= a.title]
              td
                span.dash-badge(class=a.on ? 'is-success' : '')= a.on ? 'on' : 'off'
                if a.pending
                  |  #[span.dash-badge.is-warning restart to apply]
              td
                if a.description
                  p= a.description
                if a.models.length
                  p.dash-muted Used by #{a.models.join(', ')}#{a.on ? '' : ': the engine ignores it while it is off'}.
        if isAdmin
          p
            button.btn.btn-primary.btn-sm(type='submit') Save
            span.dash-muted  Applies when the server restarts.
    if isAdmin
      section.dash-card.wide#restart
        h2 Restart
        if supervisor
          p.dash-muted Saved settings apply when the server restarts: #{supervisor} starts it again.
          a.btn.btn-default.btn-sm(href='/dashboard/admin#server') Restart from Administration
        else
          p.dash-muted Saved settings apply when the server restarts. Nothing restarts this server when it stops: restart it where it runs.
