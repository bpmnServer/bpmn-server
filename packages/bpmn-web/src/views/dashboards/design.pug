extends layout

mixin checks(m)
	if m.errors
		span.dash-badge.is-error #{m.errors} error#{m.errors === 1 ? '' : 's'}
	if m.warnings
		|
		span.dash-badge.is-warning #{m.warnings} warning#{m.warnings === 1 ? '' : 's'}
	if !m.errors && !m.warnings
		span.dash-badge.is-ok OK

//- the last run of a model's or a decision's tests (this session): passed, or failed with why
mixin run(r)
	if r
		if r.failed
			span.dash-badge.is-error(title=r.failures.map(f => `${f.name}: ${f.why}`).join('\n')) #{r.failed} of #{r.passed + r.failed} failed
		else
			span.dash-badge.is-ok #{r.passed} passed

//- what of a model its scenarios' last runs reached
mixin coverage(m)
	if m.coverage
		- const c = m.coverage
		span(title=`${c.nodes.tested} of ${c.nodes.total} nodes, ${c.flows.tested} of ${c.flows.total} flows`)= c.percent + '%'
		if c.notRun
			span.dash-muted  #{c.notRun} not run
		if c.outOfDate
			span.dash-muted(title='The model was saved after its last runs: run its tests again')  out of date

//- a button that runs the tests of one model or decision
mixin runButton(field, name)
	form.inline(method='post', action='/dashboard/design/tests')
		input(type='hidden', name='_csrf', value=_csrf)
		input(type='hidden', name=field, value=name)
		button.btn.btn-default.btn-xs(type='submit') Run

block intro
	p.dash-intro The models, what their checks find, their tests, decisions and configured tasks.

block dash
	.dash-grid
		section.dash-card.wide#overview
			h2 Overview
			.dash-stats
				.dash-stat
					b= models.length
					span models
				.dash-stat
					b= problems.errors
					span with errors
				.dash-stat
					b= problems.warnings
					span with warnings only
				.dash-stat
					b= models.filter(m => m.tests).length
					span with tests
				.dash-stat
					b= models.reduce((n, m) => n + m.tests, 0) + decisions.reduce((n, d) => n + d.tests, 0)
					span tests
				.dash-stat
					b= decisions.length
					span decisions
				.dash-stat
					b= templates.length
					span task templates
			//- a div: a form (Run all tests) can not be inside a p
			div(style='margin:14px 0 0')
				a.btn.btn-primary.btn-sm(href='/model/new') New model
				|
				a.btn.btn-default.btn-sm(href='/model/import') Import
				|
				a.btn.btn-default.btn-sm(href='/model/decision/new-decision') New decision
				if models.some(m => m.tests) || decisions.some(d => d.tests)
					|
					form.inline(method='post', action='/dashboard/design/tests')
						input(type='hidden', name='_csrf', value=_csrf)
						button.btn.btn-default.btn-sm(type='submit' title='Every model\'s scenarios and every decision\'s tests') Run all tests
				//- the catalog is hidden until it is fixed
				//- |
				//- a.btn.btn-default.btn-sm(href='/dashboard/catalog') Browse the catalog

		section.dash-card#recent
			h2 Recently changed
			if recent.length
				table
					tr
						th Model
						th Changed
						th Checks
					each m in recent
						tr
							td: a(href=`/model/edit/${encodeURIComponent(m.name)}`)= m.name
							td= m.fromNow
							td: +checks(m)
			else
				p.dash-empty No models yet.

		section.dash-card#decisions
			h2 Decisions
				span.count= decisions.length
			if decisions.length
				table
					each d in decisions
						tr
							td: a(href=`/model/decision/${encodeURIComponent(d.name)}`)= d.name
							td
								if d.tests
									a(href=`/model/decision/${encodeURIComponent(d.name)}#tests`) #{d.tests} test#{d.tests === 1 ? '' : 's'}
							td
								+run(runs.decisions[d.name])
							td
								if d.tests
									+runButton('decision', d.name)
			else
				p.dash-empty No decision tables (.dmn) in the models folder.
			h2(style='margin-top:18px') Task templates
				span.count= templates.length
			if templates.length
				table
					each t in templates
						tr
							td= t.name
							td.dash-muted= (t.appliesTo || []).join(', ').replace(/bpmn:/g, '')
			else
				p.dash-empty No element templates.
			if rejectedTemplates.length
				p.dash-muted #{rejectedTemplates.length} template file(s) left out: #{rejectedTemplates.map(r => r.file).join(', ')}

		section.dash-card.wide#models
			a#tests
			h2 Models
				span.count= models.length
			p.dash-muted Models with errors first; search, choose a feature to see the models that use it and where, or click a heading to sort. Run a model's tests here, or open it to see its Problems list and its tests (the Test tab).
			if models.length
				//- search by name or description; click a heading to sort by it, again to reverse
				.model-filters(style='display:flex; flex-wrap:wrap; gap:8px; margin:6px 0 10px')
					input#model-search.form-control.input-sm(type='search', placeholder='Search models', aria-label='Search models', style='max-width:280px')
					//- the features the models use (docs/features.yaml's markers): the models that use one, and where
					select#feature-filter.form-control.input-sm(aria-label='Models that use a feature', style='max-width:280px')
						option(value='') Any feature
						each f in (featureUse || [])
							option(value=f.id)= `${f.name} (${f.models})`
				table#models-table
					tr.sort-head
						th(data-sort='name') Model
						th(data-sort='checks') Checks
						th(data-sort='tests') Tests
						th(data-sort='coverage') Coverage
						th(data-sort='run') Last run
						th
						th(data-sort='versions') Versions
						th(data-sort='changed') Changed
					each m in models
						- const r = runs.models[m.name]
						tr.model-row(data-name=m.name.toLowerCase(), data-text=(m.name + ' ' + (m.description || '')).toLowerCase(),
							data-checks=(m.errors || 0) * 1000 + (m.warnings || 0), data-tests=m.tests || 0,
							data-coverage=m.coverage ? m.coverage.percent : -1, data-run=r ? (r.failed ? -r.failed : r.passed) : -1000,
							data-versions=m.versions || 0, data-changed=m.saved ? new Date(m.saved).getTime() : 0,
							data-where=JSON.stringify(Object.fromEntries((m.features || []).map(f => [f.id, f.at]))))
							td
								a(href=`/model/edit/${encodeURIComponent(m.name)}`)= m.name
								if m.description
									.dash-muted.model-description(title=m.description)= m.description
								.model-feature-where.dash-muted(hidden)
							td: +checks(m)
							td= m.tests ? m.tests + ' scenario' + (m.tests === 1 ? '' : 's') : ''
							td: +coverage(m)
							td: +run(runs.models[m.name])
							td
								if m.tests
									+runButton('model', m.name)
							td= m.versions || ''
							td= m.fromNow
				p#model-search-none.dash-empty(hidden) No model matches.
				script.
					(function () {
						var table = document.getElementById('models-table'), search = document.getElementById('model-search');
						var feature = document.getElementById('feature-filter');
						var rows = function () { return Array.prototype.slice.call(table.querySelectorAll('tr.model-row')); };
						// the words searched, and the feature chosen: a model that uses it shows where, each a link into the editor
						var filter = function () {
							var words = search.value.toLowerCase().split(/\s+/).filter(Boolean), chosen = feature.value, shown = 0;
							rows().forEach(function (row) {
								var where = JSON.parse(row.dataset.where || '{}')[chosen];
								var match = words.every(function (w) { return row.dataset.text.indexOf(w) >= 0; }) && (!chosen || !!where);
								row.hidden = !match;
								if (match) shown++;
								var box = row.querySelector('.model-feature-where');
								box.textContent = '';
								box.hidden = !chosen || !where;
								if (!chosen || !where) return;
								var name = row.querySelector('a').getAttribute('href');
								box.appendChild(document.createTextNode('At: '));
								where.forEach(function (id, i) {
									if (i) box.appendChild(document.createTextNode(', '));
									var link = document.createElement('a');
									link.href = name + '#element=' + encodeURIComponent(id);
									link.textContent = id;
									link.title = 'Open the model at ' + id;
									box.appendChild(link);
								});
							});
							document.getElementById('model-search-none').hidden = shown > 0;
						};
						search.addEventListener('input', filter);
						feature.addEventListener('change', filter);
						var current = null, ascending = true;
						table.querySelectorAll('th[data-sort]').forEach(function (th) {
							th.style.cursor = 'pointer';
							th.title = 'Sort by ' + th.textContent.toLowerCase();
							th.addEventListener('click', function () {
								var key = th.dataset.sort;
								ascending = current === key ? !ascending : key === 'name';
								current = key;
								var sorted = rows().sort(function (a, b) {
									var x = a.dataset[key], y = b.dataset[key];
									var order = key === 'name' ? x.localeCompare(y) : Number(x) - Number(y);
									return (ascending ? order : -order) || a.dataset.name.localeCompare(b.dataset.name);
								});
								sorted.forEach(function (row) { table.appendChild(row); });
								table.querySelectorAll('th[data-sort]').forEach(function (h) { h.textContent = h.textContent.replace(/ [▲▼]$/, ''); });
								th.textContent += ascending ? ' ▲' : ' ▼';
							});
						});
					})();
			else
				p.dash-empty No models in the models folder.
