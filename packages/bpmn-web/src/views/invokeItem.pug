extends layout

block content
	div(class="container")
		h3 Invoking Item  <strong>#{node.name}</strong> of <strong>#{processName}</strong>
	p Item Id: #{id}

	h4 Data 
	table(class="table table-striped table-bordered")
		each v in vars
			tr
				td(style="width:200px;") <strong>#{v.key}</strong>
				td #{v.value}

	div(class="form-container")
	
	
		form(name='InvokeForm',action="/invokeItem",method="post")
			input(type='hidden', name='_csrf', value=_csrf)
			input(type='hidden',name='itemId',id='itemId',value=`${id}`)
			input(type='hidden',name='returnTo',id='returnTo',value=`${returnTo}`)

			each field in fields
				- if (field.label===undefined) field.label=field.id;
				.form-group(style="max-width:400px;")
					label(for="#{field.id}")
							<strong>#{field.label}</strong>
					
					//- its choices from a source (<owf:list>, <owf:lookup>): public/javascripts/formLookup.js; its label saved as <id>Display
					- var lookup = lookups && lookups[field.id]
					- var choicesUrl = lookup ? `/dashboard/choices/task/${encodeURIComponent(id)}/${encodeURIComponent(field.id)}` : null
					- var caseData = (instance && instance.data) || {}
					- var chosen = caseData[field.id] == null ? '' : String(caseData[field.id])
					- var chosenDisplay = caseData[field.id + 'Display'] == null ? '' : String(caseData[field.id + 'Display'])
					if (lookup && lookup.kind=='list')
						select(name=`${field.id}`,class="form-control",data-choices-url=choicesUrl,data-value=chosen || field.defaultValue || '',data-filtered=(lookup.filter ? 'true' : 'false'),data-display-for=`${field.id}-display`)
							option(value='')
						input(id=`${field.id}-display`,type='hidden',name=`${field.id}Display`,value=chosenDisplay)
					else if (lookup)
						input(id=`${field.id}-text`,type='text',autocomplete='off',class="form-control",list=`${field.id}-choices`,value=chosenDisplay,data-choices-url=choicesUrl,data-value-for=`${field.id}-key`,data-display-for=`${field.id}-display`)
						input(id=`${field.id}-key`,type='hidden',name=`${field.id}`,value=(chosenDisplay ? chosen : ''))
						input(id=`${field.id}-display`,type='hidden',name=`${field.id}Display`,value=chosenDisplay)
						datalist(id=`${field.id}-choices`)
					else if (field.type=='enum')
						select(name=`${field.id}`,class="form-control")
							each v in (field['$children'])
								if (v.$type=='camunda:value')
									if (v.id == field.defaultValue)
										option(value=`${v.id}` selected) #{v.name}
									else
										option(value=`${v.id}`) #{v.name}
					else if (field.type=='date')
						input(name=`${field.id}` type='date' class="form-control")
					else
						input(name=`${field.id}` class="form-control")
			button.btn.btn-primary(type="submit") Submit
			
