# The HR application on its own, beside OWF. Copy to .env (not committed).
PORT=3200
# the people and sessions of this application (SQLite)
#HR_DATA=./data/hr.sqlite
SESSION_SECRET=
# what OWF's connector `hr` sends as x-hr-key, to call this application's /api/hr
HR_SERVICE_KEY=
# OWF, beside this application: where it is, and its API_KEY (this application asks it for a token for each person)
OWF_URL=http://localhost:3020
OWF_SERVICE_KEY=
#HR_DEMO_PASSWORD=demo1234
