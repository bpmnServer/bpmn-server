<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" id="LeaveApproval_definitions" name="Leave approval" namespace="http://bpmn-server/dmn">
  <decision id="LeaveApproval" name="Leave approval">
    <decisionTable id="LeaveApproval_table" hitPolicy="FIRST">
      <input id="LeaveApproval_days" label="Days">
        <inputExpression id="LeaveApproval_daysExpression" typeRef="number">
          <text>days</text>
        </inputExpression>
      </input>
      <input id="LeaveApproval_manager" label="Employee's manager">
        <inputExpression id="LeaveApproval_managerExpression" typeRef="string">
          <text>appServices.managerOf(actors.initiator)</text>
        </inputExpression>
      </input>
      <output id="LeaveApproval_assignee" label="Assignee" name="assignee" typeRef="string" />
      <output id="LeaveApproval_candidateGroups" label="Candidate groups" name="candidateGroups" typeRef="string" />
      <rule id="LeaveApproval_long">
        <description>A long leave: HR approves it</description>
        <inputEntry id="LeaveApproval_long_days"><text>&gt; 10</text></inputEntry>
        <inputEntry id="LeaveApproval_long_manager"><text>-</text></inputEntry>
        <outputEntry id="LeaveApproval_long_assignee"><text></text></outputEntry>
        <outputEntry id="LeaveApproval_long_groups"><text>"HR"</text></outputEntry>
      </rule>
      <rule id="LeaveApproval_own">
        <description>Any other: the employee's own manager approves it (HR's records, appServices.managerOf), and only they: [] clears the Manager lane's group</description>
        <inputEntry id="LeaveApproval_own_days"><text>-</text></inputEntry>
        <inputEntry id="LeaveApproval_own_manager"><text>not(null)</text></inputEntry>
        <outputEntry id="LeaveApproval_own_assignee"><text>appServices.managerOf(actors.initiator)</text></outputEntry>
        <outputEntry id="LeaveApproval_own_groups"><text>[]</text></outputEntry>
      </rule>
      <rule id="LeaveApproval_other">
        <description>Someone with no manager in HR's records: any manager approves it</description>
        <inputEntry id="LeaveApproval_other_days"><text>-</text></inputEntry>
        <inputEntry id="LeaveApproval_other_manager"><text>-</text></inputEntry>
        <outputEntry id="LeaveApproval_other_assignee"><text></text></outputEntry>
        <outputEntry id="LeaveApproval_other_groups"><text>"Manager"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="LeaveApproval_diagram">
      <dmndi:DMNShape id="LeaveApproval_shape" dmnElementRef="LeaveApproval">
        <dc:Bounds height="80" width="180" x="160" y="100" />
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
