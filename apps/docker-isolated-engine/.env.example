# Copy this file to .env before starting the stack. The default image is built
# from apps/hrDemo and the local packages in this repository.
BPMN_IMAGE=bpmnserver-hrdemo:local
PORT=3000

# Use long, random values in a real deployment.
API_KEY=replace-with-an-api-key
ADMIN_API_KEY=replace-with-an-admin-api-key
SESSION_SECRET=replace-with-a-session-secret
ENGINE_KEY=replace-with-an-engine-key
SECRETS_KEY=replace-with-a-secrets-key
HR_SERVICE_KEY=replace-with-an-hr-service-key

REQUIRE_AUTHENTICATION=true
ENFORCE_SECURITY=true
API_SERVICE_USER_NAME=integration
API_SERVICE_USER_GROUPS=SYSTEM
