<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_test_onboarding" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="test-onboarding" name="Employee Onboarding" isExecutable="true">
    <bpmn:startEvent id="startOnboarding" name="Employee starts onboarding">
      <bpmn:outgoing>Flow_start_submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="submitDetails" name="Submit employee details" camunda:assignee="employee">
      <bpmn:extensionElements><camunda:formData><camunda:formField id="employeeName" label="Employee name" type="string"/><camunda:formField id="department" label="Department" type="string"/><camunda:formField id="startDate" label="Start date" type="date"/></camunda:formData></bpmn:extensionElements>
      <bpmn:incoming>Flow_start_submit</bpmn:incoming><bpmn:outgoing>Flow_submit_review</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="managerReview" name="Review onboarding request" camunda:candidateGroups="managers">
      <bpmn:extensionElements><camunda:formData><camunda:formField id="approved" label="Approve onboarding?" type="boolean"/></camunda:formData></bpmn:extensionElements>
      <bpmn:incoming>Flow_submit_review</bpmn:incoming><bpmn:outgoing>Flow_review_gateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="approvalDecision" name="Approved?" default="Flow_reject_end"><bpmn:incoming>Flow_review_gateway</bpmn:incoming><bpmn:outgoing>Flow_approve_parallel</bpmn:outgoing><bpmn:outgoing>Flow_reject_end</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="onboardingSetup" name="Set up employee"><bpmn:incoming>Flow_approve_parallel</bpmn:incoming><bpmn:outgoing>Flow_setup_it</bpmn:outgoing><bpmn:outgoing>Flow_setup_hr</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:userTask id="itSetup" name="Prepare equipment and accounts" camunda:candidateGroups="it-support"><bpmn:incoming>Flow_setup_it</bpmn:incoming><bpmn:outgoing>Flow_it_join</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="hrSetup" name="Complete HR orientation" camunda:candidateGroups="hr"><bpmn:incoming>Flow_setup_hr</bpmn:incoming><bpmn:outgoing>Flow_hr_join</bpmn:outgoing></bpmn:userTask>
    <bpmn:parallelGateway id="setupComplete" name="Setup complete"><bpmn:incoming>Flow_it_join</bpmn:incoming><bpmn:incoming>Flow_hr_join</bpmn:incoming><bpmn:outgoing>Flow_complete</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:endEvent id="onboardingComplete" name="Onboarding complete"><bpmn:incoming>Flow_complete</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="onboardingRejected" name="Onboarding rejected"><bpmn:incoming>Flow_reject_end</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_submit" sourceRef="startOnboarding" targetRef="submitDetails"/>
    <bpmn:sequenceFlow id="Flow_submit_review" sourceRef="submitDetails" targetRef="managerReview"/>
    <bpmn:sequenceFlow id="Flow_review_gateway" sourceRef="managerReview" targetRef="approvalDecision"/>
    <bpmn:sequenceFlow id="Flow_approve_parallel" name="Approved" sourceRef="approvalDecision" targetRef="onboardingSetup"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${data.approved === true}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_reject_end" name="Rejected" sourceRef="approvalDecision" targetRef="onboardingRejected"/>
    <bpmn:sequenceFlow id="Flow_setup_it" sourceRef="onboardingSetup" targetRef="itSetup"/><bpmn:sequenceFlow id="Flow_setup_hr" sourceRef="onboardingSetup" targetRef="hrSetup"/>
    <bpmn:sequenceFlow id="Flow_it_join" sourceRef="itSetup" targetRef="setupComplete"/><bpmn:sequenceFlow id="Flow_hr_join" sourceRef="hrSetup" targetRef="setupComplete"/>
    <bpmn:sequenceFlow id="Flow_complete" sourceRef="setupComplete" targetRef="onboardingComplete"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_test_onboarding"><bpmndi:BPMNPlane id="Plane_test_onboarding" bpmnElement="test-onboarding">
    <bpmndi:BPMNShape id="startOnboarding_di" bpmnElement="startOnboarding"><dc:Bounds x="40" y="120" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="submitDetails_di" bpmnElement="submitDetails"><dc:Bounds x="120" y="98" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="managerReview_di" bpmnElement="managerReview"><dc:Bounds x="280" y="98" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="approvalDecision_di" bpmnElement="approvalDecision"><dc:Bounds x="440" y="113" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="onboardingSetup_di" bpmnElement="onboardingSetup"><dc:Bounds x="540" y="113" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="itSetup_di" bpmnElement="itSetup"><dc:Bounds x="640" y="40" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="hrSetup_di" bpmnElement="hrSetup"><dc:Bounds x="640" y="200" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="setupComplete_di" bpmnElement="setupComplete"><dc:Bounds x="820" y="113" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="onboardingComplete_di" bpmnElement="onboardingComplete"><dc:Bounds x="940" y="120" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="onboardingRejected_di" bpmnElement="onboardingRejected"><dc:Bounds x="540" y="340" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Flow_start_submit_di" bpmnElement="Flow_start_submit"><di:waypoint x="76" y="138"/><di:waypoint x="120" y="138"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_submit_review_di" bpmnElement="Flow_submit_review"><di:waypoint x="240" y="138"/><di:waypoint x="280" y="138"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_review_gateway_di" bpmnElement="Flow_review_gateway"><di:waypoint x="400" y="138"/><di:waypoint x="440" y="138"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_approve_parallel_di" bpmnElement="Flow_approve_parallel"><di:waypoint x="490" y="138"/><di:waypoint x="540" y="138"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_reject_end_di" bpmnElement="Flow_reject_end"><di:waypoint x="465" y="163"/><di:waypoint x="465" y="358"/><di:waypoint x="540" y="358"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_setup_it_di" bpmnElement="Flow_setup_it"><di:waypoint x="565" y="113"/><di:waypoint x="565" y="80"/><di:waypoint x="640" y="80"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_setup_hr_di" bpmnElement="Flow_setup_hr"><di:waypoint x="565" y="163"/><di:waypoint x="565" y="240"/><di:waypoint x="640" y="240"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_it_join_di" bpmnElement="Flow_it_join"><di:waypoint x="760" y="80"/><di:waypoint x="845" y="80"/><di:waypoint x="845" y="113"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_hr_join_di" bpmnElement="Flow_hr_join"><di:waypoint x="760" y="240"/><di:waypoint x="845" y="240"/><di:waypoint x="845" y="163"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_complete_di" bpmnElement="Flow_complete"><di:waypoint x="870" y="138"/><di:waypoint x="940" y="138"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
